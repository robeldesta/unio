<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_audit">
        <field name="name">Audit Room</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">7</field>
    </record>
    <record id="group_auditor" model="res.groups">
        <field name="name">Internal auditor</field>
        <field name="sequence">10</field>
        <field name="comment">Starts audit visits, raises and closes findings. Reads the books, reports and ledgers; cannot enter or change anything in them.</field>
        <field name="privilege_id" ref="privilege_audit"/>
        <field name="implied_ids" eval="[(4, ref('sonador_books.group_sb_auditor'))]"/>
    </record>
</odoo>
