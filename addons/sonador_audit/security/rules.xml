<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_visit_company" model="ir.rule">
        <field name="name">Audit visits: own companies</field>
        <field name="model_id" ref="model_sb_audit_visit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_finding_company" model="ir.rule">
        <field name="name">Audit findings: own companies</field>
        <field name="model_id" ref="model_sb_audit_finding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
