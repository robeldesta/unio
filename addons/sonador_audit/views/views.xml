<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_room" model="ir.actions.client">
        <field name="name">Audit Room</field>
        <field name="tag">sonador_audit.room</field>
    </record>

    <record id="view_finding_list" model="ir.ui.view">
        <field name="name">sb.audit.finding.list</field>
        <field name="model">sb.audit.finding</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="severity == 'high' and state in ('open', 'answered')" decoration-muted="state in ('closed', 'accepted')">
                <field name="name"/>
                <field name="create_date" string="Raised" widget="date"/>
                <field name="title"/>
                <field name="area"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'"/>
                <field name="amount" sum="Total"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="due_date"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-info="state in ('answered', 'fixed')" decoration-warning="state == 'open'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_finding_form" model="ir.ui.view">
        <field name="name">sb.audit.finding.form</field>
        <field name="model">sb.audit.finding</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header><field name="state" widget="statusbar" statusbar_visible="open,answered,fixed,closed"/></header>
                <sheet>
                    <div class="oe_title"><span class="text-muted"><field name="name" readonly="1"/></span><h1><field name="title"/></h1></div>
                    <group>
                        <group><field name="area"/><field name="severity"/><field name="amount"/><field name="currency_id" invisible="1"/></group>
                        <group><field name="owner_id"/><field name="due_date"/><field name="visit_id"/><field name="auditor_id"/></group>
                    </group>
                    <group string="What I found"><field name="found" nolabel="1" colspan="2"/></group>
                    <group string="What should be done"><field name="recommendation" nolabel="1" colspan="2"/></group>
                    <group string="Vouchers"><field name="voucher_ids" nolabel="1" colspan="2" widget="many2many_tags"/></group>
                    <group string="Management answer" invisible="not response"><field name="response" nolabel="1" colspan="2"/>
                        <field name="response_by"/><field name="response_at"/></group>
                    <group string="Closed" invisible="not closed_visit_id"><field name="closed_visit_id"/><field name="closed_note"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_finding_search" model="ir.ui.view">
        <field name="name">sb.audit.finding.search</field>
        <field name="model">sb.audit.finding</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/><field name="name"/><field name="owner_id"/>
                <filter name="open" string="Not closed" domain="[('state', 'in', ('open', 'answered', 'fixed'))]"/>
                <filter name="high" string="High" domain="[('severity', '=', 'high')]"/>
                <group><filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_area" string="Area" context="{'group_by': 'area'}"/>
                    <filter name="g_owner" string="Who answers" context="{'group_by': 'owner_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_findings" model="ir.actions.act_window">
        <field name="name">Audit findings</field>
        <field name="res_model">sb.audit.finding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="view_visit_list" model="ir.ui.view">
        <field name="name">sb.audit.visit.list</field>
        <field name="model">sb.audit.visit</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="started_at"/><field name="auditor_id"/><field name="duration"/>
                <field name="verdict" widget="badge" decoration-success="verdict == 'clean'" decoration-warning="verdict == 'minor'" decoration-danger="verdict == 'serious'"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">sb.audit.visit.form</field>
        <field name="model">sb.audit.visit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group><field name="auditor_id"/><field name="started_at"/><field name="ended_at"/><field name="duration"/></group>
                        <group><field name="since"/><field name="verdict"/><field name="state"/></group></group>
                    <group string="Summary"><field name="summary" nolabel="1" colspan="2"/></group>
                    <field name="finding_ids"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_visits" model="ir.actions.act_window">
        <field name="name">Audit visits</field>
        <field name="res_model">sb.audit.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
