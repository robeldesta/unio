<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_efris_send" model="ir.cron">
        <field name="name">EFRIS: send waiting invoices</field>
        <field name="model_id" ref="model_sb_efris"/>
        <field name="state">code</field>
        <field name="code">model._cron_send()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="seq_efris_sim" model="ir.sequence"><field name="name">EFRIS simulation</field><field name="code">sb.efris.sim</field>
        <field name="padding">6</field><field name="company_id" eval="False"/></record>
</odoo>
