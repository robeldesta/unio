<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- company settings: inventory accounts -->
    <record id="sb_company_settings_inventory" model="ir.ui.view">
        <field name="name">res.company.form.sb.settings.inventory</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="sonador_books.sb_company_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_stock_valuation_id']/.." position="after">
                <group string="Inventory">
                    <field name="account_stock_journal_id" options="{'no_create': True}"/>
                    <field name="sb_grni_account_id" options="{'no_create': True}"/>
                    <field name="sb_giv_account_id" options="{'no_create': True}"/>
                    <field name="sb_stock_adjust_account_id" options="{'no_create': True}"/>
                    <field name="sb_cost_difference_account_id" options="{'no_create': True}"/>
                    <field name="sb_allow_negative_stock"/>
                    <field name="sb_recost_entries"/>
                    <field name="sb_store_posts_by_finance"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- items: Peachtree "Maintain Inventory Items" -->
    <record id="sb_item_list" model="ir.ui.view">
        <field name="name">product.template.sb.item.list</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list>
                <field name="default_code" string="Item ID"/>
                <field name="name" string="Description"/>
                <field name="sb_item_kind"/>
                <field name="categ_id" string="Item class"/>
                <field name="uom_id" string="Unit" optional="show"/>
                <field name="list_price" string="Sales price" optional="show"/>
                <field name="standard_price" string="Unit cost" optional="show"/>
                <field name="qty_available" string="On hand" optional="show"/>
                <field name="sb_reorder_point" optional="hide"/>
                <field name="sb_vendor_id" optional="hide"/>
                <field name="sb_bin" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sb_item_form" model="ir.ui.view">
        <field name="name">product.template.sb.item.form</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Inventory Item">
                <field name="sb_pending_corrections" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert" invisible="not sb_pending_corrections">
                    Correction waiting: <field name="sb_pending_corrections" readonly="1" class="fw-bold"/>. Until it is posted
                    again, its stock is out of the books and issues dated after it are costed without it. Post it (or void it) soon.
                </div>
                <sheet>
                    <field name="is_storable" invisible="1"/>
                    <field name="type" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="cost_currency_id" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Description"/>
                        <h1><field name="name" placeholder="e.g. Cement 50 kg bag"/></h1>
                    </div>
                    <group>
                        <group string="Item">
                            <field name="default_code" string="Item ID" placeholder="e.g. CEM-50"/>
                            <field name="sb_item_kind" widget="radio" options="{'horizontal': true}"/>
                            <field name="categ_id" string="Item class (costing)" options="{'no_create': True}"/>
                            <field name="uom_id" string="Unit of measure"/>
                            <field name="barcode" optional="show"/>
                            <field name="sb_legacy_code" invisible="not sb_legacy_code"/>
                        </group>
                        <group string="Prices and cost">
                            <field name="list_price" string="Sales price"/>
                            <field name="taxes_id" string="Sales tax" widget="many2many_tags"/>
                            <field name="standard_price" string="Unit cost" readonly="is_storable"
                                   help="Stock items: the current FIFO / average cost, kept up to date by every receipt and issue."/>
                            <field name="supplier_taxes_id" string="Purchase tax" widget="many2many_tags"/>
                        </group>
                        <group string="Stock" invisible="not is_storable">
                            <field name="qty_available" string="On hand"/>
                            <field name="sb_reorder_point"/>
                            <field name="sb_reorder_qty"/>
                            <field name="sb_bin"/>
                            <button name="action_sb_beginning" type="object" string="Beginning Balances" icon="fa-flag-o"
                                    class="btn btn-secondary" colspan="2" groups="sonador_books.group_sb_accountant"/>
                        </group>
                        <group string="Buying">
                            <field name="sb_vendor_id" context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="sale_ok" string="Can be sold"/>
                            <field name="purchase_ok" string="Can be bought"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes">
                            <field name="description_sale" placeholder="Description printed on sales vouchers"/>
                            <field name="description_purchase" placeholder="Description printed on purchase vouchers"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sb_item_search" model="ir.ui.view">
        <field name="name">product.template.sb.item.search</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Item" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('default_code', 'ilike', self), ('barcode', 'ilike', self), ('sb_legacy_code', 'ilike', self)]"/>
                <field name="categ_id"/>
                <filter name="stock" string="Stock items" domain="[('sb_item_kind', '=', 'stock')]"/>
                <filter name="non_stock" string="Non-stock items" domain="[('sb_item_kind', '=', 'non_stock')]"/>
                <filter name="service" string="Services" domain="[('sb_item_kind', '=', 'service')]"/>
                <separator/>
                <filter name="sellable" string="Can be sold" domain="[('sale_ok', '=', True)]"/>
                <filter name="not_sellable" string="Not sold" domain="[('sale_ok', '=', False)]"/>
                <separator/>
                <filter name="archived" string="Inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_class" string="Item class" context="{'group_by': 'categ_id'}"/>
                    <filter name="by_kind" string="Item type" context="{'group_by': 'sb_item_kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sonador_books.action_sb_products" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="sb_item_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('sb_item_list')}),
                                      (0, 0, {'view_mode': 'form', 'view_id': ref('sb_item_form')})]"/>
        <field name="context">{'default_is_storable': True, 'default_type': 'consu'}</field>
    </record>
</odoo>
