<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sb_stock_voucher_list" model="ir.ui.view">
        <field name="name">sb.stock.voucher.list</field>
        <field name="model">sb.stock.voucher</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'void'" decoration-info="state == 'draft'">
                <field name="voucher_type" column_invisible="1"/>
                <field name="name"/>
                <field name="date"/>
                <field name="date_ec" optional="show"/>
                <field name="warehouse_id" optional="show"/>
                <field name="partner_id" string="Supplier" optional="show"/>
                <field name="department" optional="show"/>
                <field name="reference" optional="show"/>
                <field name="memo" string="Description" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="billed" optional="hide"/>
                <field name="sb_sent_finance_at" string="Sent to finance" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"
                       decoration-muted="state == 'void'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sb_stock_voucher_search" model="ir.ui.view">
        <field name="name">sb.stock.voucher.search</field>
        <field name="model">sb.stock.voucher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="department"/>
                <field name="reference"/>
                <field name="line_ids" string="Item" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="draft" string="Not posted" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="void" string="Void" domain="[('state', '=', 'void')]"/>
                <separator/>
                <filter name="not_billed" string="Not invoiced" domain="[('voucher_type', '=', 'grn'), ('state', '=', 'posted'), ('billed', '=', False)]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="by_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="by_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sb_stock_voucher_form" model="ir.ui.view">
        <field name="name">sb.stock.voucher.form</field>
        <field name="model">sb.stock.voucher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="sb_finance_posts" invisible="1"/>
                    <field name="sb_sent_finance_at" invisible="1"/>
                    <button name="action_sb_send_finance" type="object" string="Send to finance" class="btn-primary"
                            invisible="state != 'draft' or not sb_finance_posts" data-hotkey="p"
                            help="Saves it and sends it to finance: they check the unit price and VAT, then post it."/>
                    <button name="action_post_close" type="object" string="Post &amp; Close" class="btn-primary"
                            invisible="state != 'draft' or sb_finance_posts" data-hotkey="p"/>
                    <button name="action_post_new" type="object" string="Post &amp; New" class="btn-primary"
                            invisible="state != 'draft' or sb_finance_posts" data-hotkey="n"/>
                    <button name="action_post" type="object" string="Post" invisible="state != 'draft' or sb_finance_posts"/>
                    <!-- finance's step, not the store's: a store clerk receives the goods and stops there -->
                    <button name="action_create_bill" type="object" string="Enter Purchase Voucher" class="btn-primary"
                            groups="sonador_books.group_sb_clerk"
                            invisible="voucher_type != 'grn' or state != 'posted' or billed"/>
                    <button name="action_void" type="object" string="Void" invisible="state != 'posted' and not (state == 'draft' and sb_correction_before)"
                            groups="sonador_books.group_sb_accountant"
                            help="The stock goes back at the value it was posted at, a reversing entry is posted and every later issue is re-costed. Stock that later issues already used cannot go back unless the company issues without stock (it then goes below zero until the next receipt)."/>
                    <button name="action_correct" type="object" string="Correct"
                            invisible="state != 'posted' or voucher_type not in ('grn', 'giv', 'fprr', 'build') or sb_migrated or billed"
                            groups="sonador_books.group_sb_accountant"
                            confirm="Reset this voucher to draft to correct it? Its stock and entry are taken out until it is posted again, and later issues are re-costed without it meanwhile (and again when it is posted). Change the figures and post it again: it keeps its date and number. A receipt whose stock later issues used cannot be corrected unless the company allows negative stock." confirm-label="Reset to draft"/>
                    <button name="action_copy_draft" type="object" string="Copy as new" invisible="state == 'draft'"/>
                    <button name="action_view_move" type="object" string="Journal Entry" invisible="not move_id"
                            groups="account.group_account_invoice"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <field name="sb_correction_before" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'draft' or not sb_correction_before">
                    Correction in progress: this voucher's stock is out of the books until it is posted again, and issues dated
                    after it are costed without it (the stock card, valuation and ledger agree meanwhile). Change the figures and post it, or void it, as soon as you can.
                </div>
                <div class="alert alert-info mb-0" role="status" invisible="state != 'draft' or not sb_sent_finance_at">
                    Sent to finance by <field name="sb_sent_finance_by" readonly="1" class="d-inline"/> on
                    <field name="sb_sent_finance_at" readonly="1" class="d-inline"/>: they check the unit price and VAT, then post it.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'draft' or sb_sent_finance_at or not sb_sent_back_reason">
                    Sent back by finance: <field name="sb_sent_back_reason" readonly="1" class="d-inline"/>. Correct it and send it again.
                </div>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="move_id" invisible="1"/>
                    <field name="billed" invisible="1"/>
                    <field name="sb_migrated" invisible="1"/>
                    <widget name="web_ribbon" title="Void" bg_color="text-bg-danger" invisible="state != 'void'"/>
                    <widget name="web_ribbon" title="Invoiced" invisible="not billed"/>
                    <div class="oe_title">
                        <span class="o_form_label"><field name="voucher_type" readonly="1" nolabel="1"/></span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div invisible="state != 'void' or not sb_void_reason"
                         class="mb-2" groups="sonador_books.group_sb_accountant">
                        <label for="sb_void_reason" class="me-2"/>
                        <field name="sb_void_reason" readonly="state == 'void'" class="w-50"
                               placeholder="Needed to void: e.g. entered twice, wrong supplier"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" invisible="voucher_type != 'grn'" required="voucher_type == 'grn'"
                                   readonly="state != 'draft'" context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="department" invisible="voucher_type != 'giv'" readonly="state != 'draft'"
                                   placeholder="Department, site or person taking the goods"/>
                            <field name="received_by" invisible="voucher_type not in ('giv', 'grn')" readonly="state != 'draft'"
                                   string="Received by"/>
                            <field name="warehouse_id" string="From warehouse" invisible="voucher_type not in ('giv', 'transfer')"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="warehouse_id" string="Into warehouse" invisible="voucher_type not in ('grn', 'opening', 'fprr')"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="warehouse_id" string="Warehouse counted" invisible="voucher_type != 'adjustment'"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="warehouse_dest_id" invisible="voucher_type != 'transfer'" required="voucher_type == 'transfer'"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="reason_id" invisible="voucher_type != 'adjustment'" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="is_count" invisible="voucher_type != 'adjustment'" readonly="state != 'draft'" widget="boolean_toggle"/>
                            <field name="reference" readonly="state != 'draft'"
                                   placeholder="Delivery note, waybill, store request or count sheet no."/>
                            <field name="memo" string="Description" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="date_ec"/>
                            <field name="account_id" string="Charged to" invisible="voucher_type != 'giv'"
                                   readonly="state != 'draft'" options="{'no_create': True}"
                                   domain="['|', ('account_type', 'in', ('expense', 'expense_direct_cost', 'expense_depreciation')), ('name', 'ilike', 'work in pro')]"/>
                            <field name="account_id" string="Credit account" invisible="voucher_type not in ('grn', 'fprr')"
                                   readonly="state != 'draft'" options="{'no_create': True}" groups="account.group_account_invoice"/>
                            <field name="account_id" string="Gains / losses account" invisible="voucher_type != 'adjustment'"
                                   readonly="state != 'draft'" options="{'no_create': True}" groups="account.group_account_invoice"/>
                            <field name="account_id" string="Opening balance account" invisible="voucher_type != 'opening'"
                                   readonly="state != 'draft'" options="{'no_create': True}" groups="account.group_account_invoice"/>
                            <field name="analytic_account_id" invisible="voucher_type != 'giv'" readonly="state != 'draft'"
                                   groups="analytic.group_analytic_accounting"/>
                            <field name="amount_total" string="Value"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="items" string="Items">
                            <field name="line_ids" readonly="state != 'draft'" context="{'default_voucher_type': voucher_type}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="voucher_type" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_id" required="1" options="{'no_create': True}"/>
                                    <field name="name" optional="hide"/>
                                    <field name="qty_on_hand" column_invisible="parent.voucher_type != 'adjustment'" readonly="1" force_save="1"/>
                                    <field name="qty_counted" column_invisible="parent.voucher_type != 'adjustment' or not parent.is_count"/>
                                    <field name="quantity" string="Difference" column_invisible="parent.voucher_type != 'adjustment'"
                                           readonly="parent.is_count" force_save="1"/>
                                    <field name="quantity" column_invisible="parent.voucher_type == 'adjustment'" options="{'hide_trailing_zeros': true}"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="cost_locked" column_invisible="1"/>
                                    <field name="unit_cost" readonly="cost_locked" force_save="1"/>
                                    <field name="value_entered" column_invisible="1" force_save="1"/>
                                    <field name="value" sum="Total" force_save="1"
                                           readonly="cost_locked or parent.voucher_type not in ('grn', 'opening', 'fprr')"/>
                                    <field name="account_id" column_invisible="parent.voucher_type != 'giv'" optional="hide"
                                           options="{'no_create': True}" domain="['|', ('account_type', 'in', ('expense', 'expense_direct_cost', 'expense_depreciation')), ('name', 'ilike', 'work in pro')]"/>
                                </list>
                            </field>
                            <div class="text-muted small" invisible="voucher_type not in ('giv', 'transfer') or state != 'draft'">
                                Issues and transfers are valued when posted, at FIFO or average cost. The unit cost shown is the current estimate.
                            </div>
                            <div class="text-muted small" invisible="voucher_type != 'adjustment' or state != 'draft'">
                                Enter what was counted. The difference with the books is posted to stock and to the gains / losses account.
                                A gain takes the unit cost you enter (the average cost on the adjustment date by default); a loss is always valued at the average cost.
                            </div>
                        </page>
                        <page name="bills" string="Purchase Vouchers" invisible="voucher_type != 'grn'" groups="account.group_account_invoice">
                            <field name="bill_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="reference"/>
                                    <field name="amount_total"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sb_opening_stock" model="ir.actions.act_window">
        <field name="name">Opening Stock</field>
        <field name="res_model">sb.stock.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'opening')]</field>
        <field name="context">{'default_voucher_type': 'opening'}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Enter the stock you start with</p>
            <p>Quantity and unit cost per item and warehouse, on the day before you start. It is credited to opening balance equity.</p></field>
    </record>
    <record id="action_sb_grn" model="ir.actions.act_window">
        <field name="name">Goods Received</field>
        <field name="res_model">sb.stock.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'grn')]</field>
        <field name="context">{'default_voucher_type': 'grn'}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Receive goods before the supplier's invoice arrives</p>
            <p>The goods go into stock at the agreed cost; "Enter Purchase Voucher" later clears goods received not invoiced.
               Goods bought on a cash purchase or a purchase voucher are received by that voucher directly.</p></field>
    </record>
    <record id="action_sb_giv" model="ir.actions.act_window">
        <field name="name">Goods Issued (GIV)</field>
        <field name="res_model">sb.stock.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'giv')]</field>
        <field name="context">{'default_voucher_type': 'giv'}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Issue goods from the store</p>
            <p>To a department, site, job or cost centre. Valued at FIFO or average cost and charged to the expense you choose.</p></field>
    </record>
    <record id="action_sb_stock_transfer" model="ir.actions.act_window">
        <field name="name">Stock Transfers</field>
        <field name="res_model">sb.stock.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'transfer')]</field>
        <field name="context">{'default_voucher_type': 'transfer'}</field>
    </record>
    <record id="action_sb_stock_count" model="ir.actions.act_window">
        <field name="name">Stock Counts and Adjustments</field>
        <field name="res_model">sb.stock.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'adjustment')]</field>
        <field name="context">{'default_voucher_type': 'adjustment'}</field>
    </record>
    <record id="sb_adjust_reason_list" model="ir.ui.view">
        <field name="name">sb.adjust.reason.list</field>
        <field name="model">sb.adjust.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="account_id" options="{'no_create': True}" placeholder="Stock count differences"/>
                <field name="note" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_sb_adjust_reasons" model="ir.actions.act_window">
        <field name="name">Adjustment Reasons</field>
        <field name="res_model">sb.adjust.reason</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_sb_warehouses" model="ir.actions.act_window">
        <field name="name">Warehouses and Stores</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
