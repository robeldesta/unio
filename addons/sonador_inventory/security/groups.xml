<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_sonador_store">
        <field name="name">Inventory (store)</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="sequence">7</field>
    </record>
    <record id="group_sb_store_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="privilege_sonador_store"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees the Inventory app (receipts, issues, transfers, gate passes, items) and changes nothing. The stock reports also need an accounting role. For a general manager or an owner.</field>
    </record>
    <record id="group_sb_store_user" model="res.groups">
        <field name="name">Store Clerk</field>
        <field name="sequence">10</field>
        <field name="comment">Works in the Inventory app: receives (GRN), issues (GIV), transfers, prints vouchers and gate passes. Does not see Accounting, cannot void or count and adjust stock.</field>
        <field name="privilege_id" ref="privilege_sonador_store"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user')), (4, ref('group_sb_store_viewer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
