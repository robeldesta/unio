<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_perf_template_form" model="ir.ui.view">
        <field name="name">sb.perf.template.form</field>
        <field name="model">sb.perf.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/><field name="active"/></group>
                    <field name="criterion_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="weight"/>
                            <field name="applies"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_perf_template_list" model="ir.ui.view">
        <field name="name">sb.perf.template.list</field>
        <field name="model">sb.perf.template</field>
        <field name="arch" type="xml">
            <list><field name="name"/></list>
        </field>
    </record>
</odoo>
