<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- KPI library -->
    <record id="view_kpi_list" model="ir.ui.view">
        <field name="name">sb.perf.kpi.list</field>
        <field name="model">sb.perf.kpi</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="department_id" optional="show"/>
                <field name="unit"/>
                <field name="frequency"/>
                <field name="higher_is_better" string="Higher better"/>
                <field name="source"/>
                <field name="auto_key" optional="show"/>
                <field name="target"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_kpi_form" model="ir.ui.view">
        <field name="name">sb.perf.kpi.form</field>
        <field name="model">sb.perf.kpi</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_default_levels" type="object" string="Use the standard levels" class="btn-secondary"
                            confirm="Replace this KPI's performance levels with the standard five (Excellent 95%, Very good 85%, Good 75%, Fair 60%, Poor)?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Credit collection: % of credit collected vs target"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="department_id"/>
                            <field name="unit"/>
                            <field name="target"/>
                            <field name="higher_is_better"/>
                            <field name="frequency"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="auto_key" invisible="source != 'auto'" required="source == 'auto'"/>
                            <field name="bands" readonly="level_ids"/>
                            <field name="description"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="how_measured" placeholder="How it is measured: what counts, where the figure comes from, who enters it"/>
                    <notebook>
                        <page string="Performance levels">
                            <field name="level_ids">
                                <list editable="bottom">
                                    <field name="min_pct"/>
                                    <field name="name"/>
                                    <field name="score"/>
                                    <field name="color" widget="color"/>
                                </list>
                            </field>
                            <div class="text-muted small">No levels here: the scoring bands above decide the score (95%+ = 5, 85% = 4, 75% = 3, 60% = 2, below = 1).</div>
                        </page>
                        <page string="Assigned to">
                            <field name="assignment_ids">
                                <list editable="bottom">
                                    <field name="department_id"/>
                                    <field name="job_id"/>
                                    <field name="employee_id"/>
                                    <field name="weight"/>
                                    <field name="target"/>
                                    <field name="template_id" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_kpi_search" model="ir.ui.view">
        <field name="name">sb.perf.kpi.search</field>
        <field name="model">sb.perf.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <filter name="assigned" string="Assigned" domain="[('assignment_ids', '!=', False)]"/>
                <filter name="computed" string="Computed" domain="[('source', '=', 'auto')]"/>
                <filter name="entered" string="Entered" domain="[('source', '=', 'manual')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_dept" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="by_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_kpi_library" model="ir.actions.act_window">
        <field name="name">KPI Library</field>
        <field name="res_model">sb.perf.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_assigned': 1}</field>
    </record>

    <!-- templates per position / department -->
    <record id="view_kpi_template_list" model="ir.ui.view">
        <field name="name">sb.perf.kpi.template.list</field>
        <field name="model">sb.perf.kpi.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="weight_total"/>
                <field name="assignment_count"/>
            </list>
        </field>
    </record>
    <record id="view_kpi_template_form" model="ir.ui.view">
        <field name="name">sb.perf.kpi.template.form</field>
        <field name="model">sb.perf.kpi.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply" type="object" string="Assign to the position / department" class="btn-primary"
                            confirm="Make or update the KPI assignments for this position (or department) with these weights and targets?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_assignments" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Sales representative scorecard"/></h1></div>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="weight_total"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Job description / what this role is accountable for"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="kpi_id"/>
                            <field name="unit"/>
                            <field name="weight"/>
                            <field name="target"/>
                        </list>
                    </field>
                    <div class="text-muted small">Weights usually add up to 1 (100%). A target of 0 uses the KPI's own target.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_kpi_templates" model="ir.actions.act_window">
        <field name="name">KPI Templates</field>
        <field name="res_model">sb.perf.kpi.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- assignments -->
    <record id="view_kpi_assign_list" model="ir.ui.view">
        <field name="name">sb.perf.kpi.assign.list</field>
        <field name="model">sb.perf.kpi.assign</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="kpi_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="employee_id"/>
                <field name="weight"/>
                <field name="target"/>
                <field name="template_id" readonly="1" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_kpi_assign_search" model="ir.ui.view">
        <field name="name">sb.perf.kpi.assign.search</field>
        <field name="model">sb.perf.kpi.assign</field>
        <field name="arch" type="xml">
            <search>
                <field name="kpi_id"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <group>
                    <filter name="by_dept" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="by_job" string="Position" context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_kpi_assign" model="ir.actions.act_window">
        <field name="name">KPI Assignments</field>
        <field name="res_model">sb.perf.kpi.assign</field>
        <field name="view_mode">list</field>
    </record>

    <!-- results per period -->
    <record id="view_kpi_value_list" model="ir.ui.view">
        <field name="name">sb.perf.kpi.value.list</field>
        <field name="model">sb.perf.kpi.value</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="month"/>
                <field name="employee_id"/>
                <field name="kpi_id"/>
                <field name="target"/>
                <field name="actual"/>
                <field name="weight"/>
                <field name="achievement" widget="percentage" readonly="1"/>
                <field name="score" readonly="1"/>
                <field name="level" readonly="1"/>
                <field name="source" readonly="1"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_kpi_value_search" model="ir.ui.view">
        <field name="name">sb.perf.kpi.value.search</field>
        <field name="model">sb.perf.kpi.value</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="kpi_id"/>
                <field name="month"/>
                <filter name="computed" string="Computed" domain="[('source', '=', 'auto')]"/>
                <filter name="entered" string="Entered" domain="[('source', '=', 'manual')]"/>
                <filter name="brought" string="Brought over" domain="[('source', '=', 'import')]"/>
                <group>
                    <filter name="by_month" string="Period" context="{'group_by': 'month:day'}"/>
                    <filter name="by_emp" string="Person" context="{'group_by': 'employee_id'}"/>
                    <filter name="by_kpi" string="KPI" context="{'group_by': 'kpi_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_kpi_values" model="ir.actions.act_window">
        <field name="name">KPI Results</field>
        <field name="res_model">sb.perf.kpi.value</field>
        <field name="view_mode">list</field>
    </record>

    <!-- scorecard results -->
    <record id="view_kpi_score_list" model="ir.ui.view">
        <field name="name">sb.perf.kpi.score.list</field>
        <field name="model">sb.perf.kpi.score</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="month"/>
                <field name="period"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id" optional="show"/>
                <field name="kpis"/>
                <field name="results"/>
                <field name="points" optional="hide"/>
                <field name="max_points" optional="hide"/>
                <field name="percent"/>
                <field name="achievement" optional="show"/>
                <field name="rating"/>
                <field name="source" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_kpi_score_pivot" model="ir.ui.view">
        <field name="name">sb.perf.kpi.score.pivot</field>
        <field name="model">sb.perf.kpi.score</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="department_id" type="row"/>
                <field name="month" interval="day" type="col"/>
                <field name="percent" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_kpi_score_search" model="ir.ui.view">
        <field name="name">sb.perf.kpi.score.search</field>
        <field name="model">sb.perf.kpi.score</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="month"/>
                <filter name="with_results" string="With results" domain="[('results', '>', 0)]"/>
                <group>
                    <filter name="by_month" string="Period" context="{'group_by': 'month:day'}"/>
                    <filter name="by_dept" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_kpi_scores" model="ir.actions.act_window">
        <field name="name">Scorecard Results</field>
        <field name="res_model">sb.perf.kpi.score</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_with_results': 1}</field>
    </record>

    <!-- key results (backend form, e.g. to link plan tasks) -->
    <record id="view_kr_form" model="ir.ui.view">
        <field name="name">sb.perf.kr.form</field>
        <field name="model">sb.perf.kr</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh" type="object" string="Refresh now" class="btn-secondary" invisible="measure == 'manual'"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="goal_id"/>
                            <field name="measure"/>
                            <field name="kpi_id" invisible="measure != 'kpi'" required="measure == 'kpi'"/>
                            <field name="rollup" invisible="measure != 'kpi'"/>
                        </group>
                        <group>
                            <field name="start_value"/>
                            <field name="target_value"/>
                            <field name="current_value" readonly="measure != 'manual'"/>
                            <field name="unit"/>
                            <field name="progress"/>
                            <field name="source_note" invisible="measure == 'manual'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_kr_list" model="ir.ui.view">
        <field name="name">sb.perf.kr.list</field>
        <field name="model">sb.perf.kr</field>
        <field name="arch" type="xml">
            <list>
                <field name="goal_id"/>
                <field name="name"/>
                <field name="measure"/>
                <field name="kpi_id" optional="show"/>
                <field name="current_value"/>
                <field name="target_value"/>
                <field name="progress"/>
            </list>
        </field>
    </record>
    <record id="action_krs" model="ir.actions.act_window">
        <field name="name">Key Results</field>
        <field name="res_model">sb.perf.kr</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="cron_kr_refresh" model="ir.cron">
        <field name="name">Performance: refresh key results from KPIs and plans</field>
        <field name="model_id" ref="model_sb_perf_kr"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <menuitem id="menu_kpi_root" name="KPIs" parent="sonador_books.menu_hr_root" sequence="6" groups="sonador_books.group_sb_hr"/>
    <menuitem id="menu_kpi_scores" name="Scorecard Results" parent="menu_kpi_root" action="action_kpi_scores" sequence="1"/>
    <menuitem id="menu_kpi_values" name="KPI Results" parent="menu_kpi_root" action="action_kpi_values" sequence="2"/>
    <menuitem id="menu_kpi_krs" name="Key Results" parent="menu_kpi_root" action="action_krs" sequence="3"/>
    <menuitem id="menu_kpi_library" name="KPI Library" parent="menu_kpi_root" action="action_kpi_library" sequence="10"/>
    <menuitem id="menu_kpi_templates" name="KPI Templates" parent="menu_kpi_root" action="action_kpi_templates" sequence="11"/>
    <menuitem id="menu_kpi_assign" name="KPI Assignments" parent="menu_kpi_root" action="action_kpi_assign" sequence="12"/>
</odoo>
