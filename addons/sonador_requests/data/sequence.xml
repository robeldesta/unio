<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_payment_request" model="ir.sequence">
        <field name="name">Payment request</field>
        <field name="code">sb.payment.request</field>
        <field name="prefix">PR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_petty_request" model="ir.sequence">
        <field name="name">Petty cash request</field>
        <field name="code">sb.payment.request.petty</field>
        <field name="prefix">PCR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_perdiem_request" model="ir.sequence">
        <field name="name">Driver per diem request</field>
        <field name="code">sb.payment.request.perdiem</field>
        <field name="prefix">PDR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_purchase_request" model="ir.sequence">
        <field name="name">Purchase request</field>
        <field name="code">sb.purchase.request</field>
        <field name="prefix">PUR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
