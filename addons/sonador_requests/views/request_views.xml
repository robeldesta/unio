<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_list" model="ir.ui.view">
        <field name="name">sb.payment.request.list</field>
        <field name="model">sb.payment.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state in ('dept', 'finance', 'gm')" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="date"/>
                <field name="request_type" optional="show"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="department_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="paid_to" optional="hide"/>
                <field name="category_id" optional="show"/>
                <field name="description" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="amount_paid" optional="show" sum="Paid"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sb_waiting_for" optional="show"/>
                <field name="state" widget="badge" decoration-info="state in ('dept', 'finance', 'gm')" decoration-success="state in ('approved', 'paid')" decoration-warning="state == 'partial'"/>
                <field name="sb_migrated" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_payment_request_search" model="ir.ui.view">
        <field name="name">sb.payment.request.search</field>
        <field name="model">sb.payment.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="paid_to"/>
                <field name="requester_id"/>
                <field name="description"/>
                <field name="category_id"/>
                <field name="sb_legacy_ref"/>
                <filter name="waiting_me" string="Waiting for me" domain="[('sb_waiting_me', '=', True)]"/>
                <filter name="mine" string="My requests" domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_approval" string="In approval" domain="[('state', 'in', ('dept', 'finance', 'gm'))]"/>
                <filter name="to_pay" string="To pay" domain="[('state', 'in', ('approved', 'partial'))]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="migrated" string="Brought over" domain="[('sb_migrated', '=', True)]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_type" string="Kind" context="{'group_by': 'request_type'}"/>
                    <filter name="g_dept" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="g_cat" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="g_req" string="Requested by" context="{'group_by': 'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_payment_request_form" model="ir.ui.view">
        <field name="name">sb.payment.request.form</field>
        <field name="model">sb.payment.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit for approval" class="btn-primary" invisible="state != 'draft' or not sb_is_owner"/>
                    <!-- each person sees only their own step: the department head approves, finance checks, the general
                         manager authorizes; the requester submits, cancels and reopens -->
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="not sb_can_decide or state != 'dept'"/>
                    <button name="action_approve" type="object" string="Check" class="btn-primary" invisible="not sb_can_decide or state != 'finance'"/>
                    <button name="action_approve" type="object" string="Authorize" class="btn-primary" invisible="not sb_can_decide or state != 'gm'"/>
                    <button name="action_send_back" type="object" string="Send back" invisible="not sb_can_decide"/>
                    <button name="action_create_voucher" type="object" string="Make payment voucher" class="btn-primary"
                            invisible="state not in ('approved', 'partial')" groups="sonador_requests.group_request_cashier"/>
                    <button name="action_cancel" type="object" string="Cancel request" invisible="state in ('cancel', 'paid', 'partial') or not sb_can_cancel"/>
                    <button name="action_draft" type="object" string="Reopen" invisible="state != 'cancel' or not sb_is_owner"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,dept,finance,gm,approved,paid"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'draft' or not sent_back_reason">
                    Sent back by <field name="sent_back_by" readonly="1" class="d-inline fw-bold"/>: <field name="sent_back_reason" class="d-inline"/>
                </div>
                <div class="alert alert-secondary mb-0" role="alert" invisible="state != 'cancel' or not cancel_reason">
                    Cancelled: <field name="cancel_reason" class="d-inline"/>
                </div>
                <div class="alert alert-info mb-0" role="alert" invisible="not sb_waiting_for">
                    Waiting for <field name="sb_waiting_for" class="d-inline fw-bold"/>. Approval path: <field name="route" class="d-inline"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vouchers" type="object" class="oe_stat_button" icon="fa-money" invisible="voucher_count == 0" groups="account.group_account_invoice,account.group_account_readonly">
                            <field name="voucher_count" widget="statinfo" string="Vouchers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_type" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state not in ('draft', 'finance')"/>
                            <field name="paid_to" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state not in ('draft', 'dept', 'finance')" options="{'no_create': True}"/>
                            <field name="amount" readonly="state != 'draft' or request_type == 'perdiem'" force_save="1"/>
                            <field name="description" readonly="state != 'draft'"/>
                            <field name="attachment_note" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="requester_id" readonly="state != 'draft'" widget="many2one_avatar_user"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="dept_approver_id" readonly="state != 'draft'" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sb_can_decide" invisible="1"/>
                            <field name="sb_is_owner" invisible="1"/>
                            <field name="sb_can_cancel" invisible="1"/>
                            <field name="order_ref" invisible="not order_ref"/>
                            <field name="sb_legacy_ref" invisible="not sb_migrated"/>
                            <field name="sb_migrated" invisible="not sb_migrated"/>
                        </group>
                    </group>
                    <group invisible="state not in ('dept', 'finance', 'gm', 'approved')">
                        <field name="reason" placeholder="Why it goes back or is cancelled (the requester sees it)"/>
                    </group>
                    <group string="Driver per diem" invisible="request_type != 'perdiem'">
                        <group>
                            <field name="trip_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="driver_id" readonly="state != 'draft'"/>
                            <field name="vehicle_id" readonly="state != 'draft'"/>
                            <field name="destination" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="days" readonly="state != 'draft'"/>
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="extra_amount" readonly="state != 'draft'"/>
                            <field name="extra_reason" readonly="state != 'draft'" invisible="not extra_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment order" name="order">
                            <field name="line_ids" readonly="state not in ('draft', 'dept', 'finance', 'gm')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="vehicle_id" optional="hide"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <div class="text-muted">Finance codes the accounts here; the lines add up to the amount asked. Empty: the category's account.</div>
                        </page>
                        <page string="Approvals" name="approvals">
                            <group>
                                <group>
                                    <field name="submitted_at"/>
                                    <field name="dept_by"/>
                                    <field name="dept_at"/>
                                </group>
                                <group>
                                    <field name="finance_by"/>
                                    <field name="finance_at"/>
                                    <field name="gm_by"/>
                                    <field name="gm_at"/>
                                </group>
                            </group>
                        </page>
                        <page string="Payment" name="payment" invisible="state not in ('approved', 'partial', 'paid')" groups="account.group_account_invoice,account.group_account_readonly">
                            <group>
                                <field name="amount_paid"/>
                                <field name="amount_due"/>
                            </group>
                            <field name="voucher_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payment_requests" model="ir.actions.act_window">
        <field name="name">Payment requests</field>
        <field name="res_model">sb.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('request_type', '=', 'payment')]</field>
        <field name="context">{'default_request_type': 'payment'}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Ask for a payment</p>
            <p>Your department head approves it, finance checks it and the general manager gives the final approval; then the cashier pays it.</p></field>
    </record>
    <record id="action_petty_requests" model="ir.actions.act_window">
        <field name="name">Petty cash requests</field>
        <field name="res_model">sb.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('request_type', '=', 'petty')]</field>
        <field name="context">{'default_request_type': 'petty'}</field>
    </record>
    <record id="action_perdiem_requests" model="ir.actions.act_window">
        <field name="name">Driver per diem</field>
        <field name="res_model">sb.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('request_type', '=', 'perdiem')]</field>
        <field name="context">{'default_request_type': 'perdiem'}</field>
    </record>
    <record id="action_requests_waiting" model="ir.actions.act_window">
        <field name="name">Waiting for me</field>
        <field name="res_model">sb.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_waiting_me': 1}</field>
    </record>
    <record id="action_requests_mine" model="ir.actions.act_window">
        <field name="name">My requests</field>
        <field name="res_model">sb.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_mine': 1}</field>
    </record>
    <record id="action_requests_to_pay" model="ir.actions.act_window">
        <field name="name">To pay</field>
        <field name="res_model">sb.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_pay': 1}</field>
    </record>


    <!-- the voucher shows the request it pays -->
    <record id="view_voucher_form_request" model="ir.ui.view">
        <field name="name">sb.voucher.form.request</field>
        <field name="model">sb.voucher</field>
        <field name="inherit_id" ref="sonador_books.sb_voucher_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='reference'])[1]" position="after">
                <field name="sb_request_id" invisible="not sb_request_id"/>
            </xpath>
        </field>
    </record>

    <!-- layout: the documents a voucher pays (request, purchase order) sit with its number and date, on the right -->
    <record id="view_voucher_form_links_layout" model="ir.ui.view">
        <field name="name">sb.voucher.form.links.layout</field>
        <field name="model">sb.voucher</field>
        <field name="inherit_id" ref="sonador_books.sb_voucher_form"/>
        <field name="priority">121</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_state']" position="before">
                <xpath expr="//group/field[@name='sb_request_id']" position="move"/>
                <xpath expr="//group/field[@name='sb_purchase_id']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
