<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_request_finance" model="res.groups">
        <field name="name">Requests: finance check</field>
        <field name="comment">Checks payment and purchase requests after the department head and codes the accounts they are paid to (the payment order). Sees every request.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_request_gm" model="res.groups">
        <field name="name">Requests: final approval (general manager)</field>
        <field name="comment">Gives the final approval of requests above the company's limit. Sees every request.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_request_cashier" model="res.groups">
        <field name="name">Requests: cashier (pays)</field>
        <field name="comment">Makes the payment voucher (or petty cash voucher) from an approved request. Needs Accounting rights to post it.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_request_admin" model="res.groups">
        <field name="name">Requests: administrator</field>
        <field name="comment">Sets the approval rules and categories, cancels any request, approves for an absent department head (logged as on behalf).</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
