<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pr_company" model="ir.rule">
        <field name="name">Payment requests: my companies</field>
        <field name="model_id" ref="model_sb_payment_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pr_own" model="ir.rule">
        <field name="name">Payment requests: mine and those I approve</field>
        <field name="model_id" ref="model_sb_payment_request"/>
        <field name="domain_force">['|', '|', '|', '|', '|', ('requester_id', '=', user.id), ('create_uid', '=', user.id), ('dept_approver_id', '=', user.id), ('dept_by', '=', user.id), ('sb_step_user_id', '=', user.id), ('gm_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_pr_all" model="ir.rule">
        <field name="name">Payment requests: all (finance, general manager, cashier, administrator)</field>
        <field name="model_id" ref="model_sb_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_request_finance')), (4, ref('group_request_gm')), (4, ref('group_request_cashier')), (4, ref('group_request_admin')), (4, ref('sonador_books.group_sb_auditor'))]"/>
    </record>
    <record id="rule_pur_company" model="ir.rule">
        <field name="name">Purchase requests: my companies</field>
        <field name="model_id" ref="model_sb_purchase_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pur_own" model="ir.rule">
        <field name="name">Purchase requests: mine and those I approve</field>
        <field name="model_id" ref="model_sb_purchase_request"/>
        <field name="domain_force">['|', '|', '|', '|', '|', ('requester_id', '=', user.id), ('create_uid', '=', user.id), ('dept_approver_id', '=', user.id), ('dept_by', '=', user.id), ('sb_step_user_id', '=', user.id), ('gm_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_pur_all" model="ir.rule">
        <field name="name">Purchase requests: all (finance, general manager, purchasing, administrator)</field>
        <field name="model_id" ref="model_sb_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_request_finance')), (4, ref('group_request_gm')), (4, ref('purchase.group_purchase_user')), (4, ref('group_request_admin')), (4, ref('sonador_books.group_sb_auditor'))]"/>
    </record>
</odoo>
