<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="category_school">
        <field name="name">School</field>
        <field name="sequence">40</field>
    </record>
    <record model="res.groups.privilege" id="privilege_school">
        <field name="name">School</field>
        <field name="category_id" ref="category_school"/>
        <field name="sequence">40</field>
    </record>
    <record id="group_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_school"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Takes attendance and enters marks for their classes.</field>
    </record>
    <record id="group_office" model="res.groups">
        <field name="name">School office</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_school"/>
        <field name="implied_ids" eval="[(4, ref('group_teacher'))]"/>
        <field name="comment">Students, admissions, classes, fees and report cards.</field>
    </record>
    <record id="group_head" model="res.groups">
        <field name="name">Principal / director</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_school"/>
        <field name="implied_ids" eval="[(4, ref('group_office'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
