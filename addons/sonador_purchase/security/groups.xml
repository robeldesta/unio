<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_sonador_purchase">
        <field name="name">Purchase</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="sequence">6</field>
    </record>
    <record id="group_sb_purchase_user" model="res.groups">
        <field name="name">Purchase Clerk</field>
        <field name="sequence">10</field>
        <field name="comment">Works in the Purchase app: requests for quotation, purchase orders, vendor prices; follows deliveries, bills and payments of the orders. Does not post GRNs, bills or payments.</field>
        <field name="privilege_id" ref="privilege_sonador_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <!-- Books clerks and store clerks work with purchase orders too -->
    <record id="sonador_books.group_sb_clerk" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
</odoo>
