<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sb_purchase_home" model="ir.actions.client">
        <field name="name">Purchase</field>
        <field name="tag">sonador_inventory.app_home</field>
        <field name="params">{'app': 'purchase'}</field>
    </record>
    <record id="action_sb_rep_po_status" model="ir.actions.client">
        <field name="name">Purchase Orders: Ordered, Received, Billed</field>
        <field name="tag">sonador_books.report</field>
        <field name="context">{'report': 'po_status', 'catalog_key': 'po_status'}</field>
    </record>
    <record id="action_sb_rep_po_payments" model="ir.actions.client">
        <field name="name">Purchase Orders: Paid and Owed</field>
        <field name="tag">sonador_books.report</field>
        <field name="context">{'report': 'po_payments', 'catalog_key': 'po_payments'}</field>
    </record>
    <record id="action_sb_rep_grni" model="ir.actions.client">
        <field name="name">Goods Received Not Invoiced</field>
        <field name="tag">sonador_books.report</field>
        <field name="context">{'report': 'grni', 'catalog_key': 'grni'}</field>
    </record>

    <menuitem id="menu_purchase_root" name="Purchase" sequence="23" web_icon="sonador_purchase,static/description/icon.png"
              groups="group_sb_purchase_user"/>
    <menuitem id="menu_purchase_home" name="Home" parent="menu_purchase_root" action="action_sb_purchase_home" sequence="1"/>
    <menuitem id="menu_purchase_orders" name="Orders" parent="menu_purchase_root" sequence="10"/>
    <menuitem id="menu_purchase_rfq" name="Requests for Quotation" parent="menu_purchase_orders" action="action_sb_rfq" sequence="1"/>
    <menuitem id="menu_purchase_po" name="Purchase Orders" parent="menu_purchase_orders" action="action_sb_purchase_orders" sequence="2"/>
    <menuitem id="menu_purchase_vendors" name="Vendors" parent="menu_purchase_root" sequence="20"/>
    <menuitem id="menu_purchase_vendor_list" name="Vendors" parent="menu_purchase_vendors" action="sonador_books.action_sb_vendors" sequence="1"/>
    <menuitem id="menu_purchase_vendor_prices" name="Vendor Prices" parent="menu_purchase_vendors" action="action_sb_vendor_prices" sequence="2"/>
    <menuitem id="menu_purchase_items" name="Items" parent="menu_purchase_vendors" action="sonador_books.action_sb_products" sequence="3"/>
    <menuitem id="menu_purchase_receipts" name="Deliveries" parent="menu_purchase_root" sequence="30"/>
    <menuitem id="menu_purchase_grns" name="Goods Received (GRN)" parent="menu_purchase_receipts" action="action_sb_po_grns" sequence="1"/>
    <menuitem id="menu_purchase_reports" name="Reports" parent="menu_purchase_root" sequence="50"/>
    <menuitem id="menu_purchase_rep_status" name="Ordered, Received, Billed" parent="menu_purchase_reports" action="action_sb_rep_po_status" sequence="1"/>
    <menuitem id="menu_purchase_rep_pay" name="Paid and Owed" parent="menu_purchase_reports" action="action_sb_rep_po_payments" sequence="2"/>
    <menuitem id="menu_purchase_rep_grni" name="Received, Not Billed" parent="menu_purchase_reports" action="action_sb_rep_grni" sequence="3"/>

    <!-- Accounting: Vendors & Purchases -->
    <menuitem id="menu_sb_rfq" name="Requests for Quotation" parent="sonador_books.menu_sb_vendors" action="action_sb_rfq" sequence="2"/>
    <menuitem id="menu_sb_po" name="Purchase Orders" parent="sonador_books.menu_sb_vendors" action="action_sb_purchase_orders" sequence="3"/>
    <menuitem id="menu_sb_rep_po_status" name="Purchase Orders: Received / Billed" parent="sonador_books.menu_sb_reports" action="action_sb_rep_po_status" sequence="14"/>
    <menuitem id="menu_sb_rep_po_pay" name="Purchase Orders: Paid / Owed" parent="sonador_books.menu_sb_reports" action="action_sb_rep_po_payments" sequence="15"/>

    <!-- Inventory app: receive against the order -->
    <menuitem id="menu_store_po" name="Purchase Orders to Receive" parent="sonador_inventory.menu_store_receive" action="action_sb_purchase_orders" sequence="0"/>
    <menuitem id="menu_store_rep_po" name="Expected from Suppliers" parent="sonador_inventory.menu_store_reports" action="action_sb_rep_po_status" sequence="12"/>
</odoo>
