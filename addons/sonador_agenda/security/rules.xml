<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_agenda_todo_own" model="ir.rule">
        <field name="name">To-dos: yours, or ones you gave to someone</field>
        <field name="model_id" ref="model_agenda_todo"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_agenda_mark_company" model="ir.rule">
        <field name="name">Agenda marks: own companies</field>
        <field name="model_id" ref="model_agenda_mark"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
