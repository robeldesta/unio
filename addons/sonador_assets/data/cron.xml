<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_depreciation" model="ir.cron">
        <field name="name">Fixed assets: post depreciation</field>
        <field name="model_id" ref="model_sb_assets"/>
        <field name="state">code</field>
        <field name="code">model._cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <!-- on every upgrade: each company's country asset classes, on their own accounts -->
    <function model="sb.assets" name="apply_rules_all"/>
</odoo>
