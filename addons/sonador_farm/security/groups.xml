<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_worker" model="res.groups">
        <field name="name">Farm: worker</field>
        <field name="comment">Records the day of a flock (deaths, feed, eggs, weights, manure) and gives the medicine due.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Farm: manager</field>
        <field name="comment">Starts and closes flocks, sees the money of each flock, sells, sets the farm up.</field>
        <field name="implied_ids" eval="[(4, ref('group_worker'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
