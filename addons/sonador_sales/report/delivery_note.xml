<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_delivery_note" model="ir.actions.report">
        <field name="name">Delivery Note</field>
        <field name="model">sb.delivery.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sonador_sales.report_delivery_note</field>
        <field name="print_report_name">'Delivery note %s' % object.reference</field>
        <field name="binding_model_id" ref="model_sb_delivery_batch"/>
    </record>
    <template id="report_delivery_note">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="b">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Delivery Note <span t-field="b.reference"/></h2>
                        <table class="table table-sm table-borderless mb-3" style="width:100%">
                            <tr><td><b>Customer</b></td><td><span t-field="b.partner_id"/></td><td><b>Date</b></td><td><span t-field="b.date"/> (<span t-field="b.date_ec"/>)</td></tr>
                            <tr><td><b>Sale Order</b></td><td t-esc="b.delivery_id.sale_order_id.name or ''"/><td><b>Invoices</b></td>
                                <td t-esc="b.invoice_id.name or ', '.join(b.delivery_id.voucher_ids.filtered(lambda v: v.state == 'posted').mapped('name'))"/></tr>
                            <tr><td><b>Delivery Method</b></td><td><span t-field="b.delivery_method"/></td><td><b>Delivery Vehicle / Driver</b></td><td><t t-esc="b.vehicle or ''"/> <t t-esc="b.driver or ''"/></td></tr>
                            <tr t-if="b.delivery_id.dispatch_ref"><td><b>Dispatch Voucher</b></td><td><span t-field="b.delivery_id.dispatch_ref"/></td><td/><td/></tr>
                        </table>
                        <p t-if="b.delivery_id.notes" t-field="b.delivery_id.notes"/>
                        <table class="table table-sm">
                            <thead><tr><th>Item</th><th class="text-end">Quantity</th><th>Unit</th></tr></thead>
                            <tbody>
                                <tr t-foreach="b.line_ids" t-as="l"><td><span t-field="l.product_id"/></td><td class="text-end"><span t-field="l.quantity"/></td><td><span t-field="l.uom_id"/></td></tr>
                            </tbody>
                        </table>
                        <table style="width:100%; margin-top: 48px">
                            <tr><td style="width:33%">Loaded by ____________________</td><td style="width:33%">Gate / security ____________________</td>
                                <td>Received by (customer) ____________________</td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
