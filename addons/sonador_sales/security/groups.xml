<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_sonador_sales">
        <field name="name">Sales</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">7</field>
    </record>
    <record id="group_sb_sales_user" model="res.groups">
        <field name="name">Sales Clerk</field>
        <field name="sequence">10</field>
        <field name="comment">Works in the Sales app: customers, quotations, sales orders, sales invoices and cash sales, returns, delivery orders. Does not see Accounting (receipts, banking, ledgers).</field>
        <field name="privilege_id" ref="privilege_sonador_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman_all_leads')),
                                         (4, ref('account.group_account_invoice')), (4, ref('stock.group_stock_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
