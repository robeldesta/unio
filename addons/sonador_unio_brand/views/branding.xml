<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- browser tab: title and icon -->
    <template id="layout" inherit_id="web.layout" priority="99">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'Unio'"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/sonador_unio_brand/static/img/favicon.png'</attribute>
            <attribute name="type">image/png</attribute>
        </xpath>
    </template>

    <!-- the app installed on a phone or desktop -->
    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
            <attribute name="href">/sonador_unio_brand/static/img/unio-icon-ios.png</attribute>
        </xpath>
        <xpath expr="//meta[@name='theme-color']" position="attributes">
            <attribute name="content">#1B2240</attribute>
        </xpath>
    </template>

    <!-- sign-in page: the company's logo (Unio until it sets one), Unio instead of "Powered by Odoo" -->
    <template id="login_layout" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('card-body')]/div[1]/img" position="attributes">
            <attribute name="t-attf-src">/unio/login_logo</attribute>
        </xpath>
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a href="https://unio.et" target="_blank" class="o_unio_powered">Powered by <img src="/sonador_unio_brand/static/img/unio_wordmark.svg" alt="Unio" style="height: 1.25em; vertical-align: -0.3em;"/></a>
        </xpath>
    </template>

    <template id="brand_promotion_message" inherit_id="web.brand_promotion_message">
        <xpath expr="//t[@t-set='odoo_logo']" position="replace">
            <t t-set="odoo_logo">
                <a target="_blank" href="https://unio.et" class="badge text-bg-light">
                    <img alt="Unio" src="/sonador_unio_brand/static/img/unio_wordmark.svg" style="width: auto; height: 1.1em; vertical-align: -0.2em;"/>
                </a>
            </t>
        </xpath>
    </template>

    <template id="portal_record_sidebar" inherit_id="portal.portal_record_sidebar">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a target="_blank" href="https://unio.et" title="Unio"><img src="/sonador_unio_brand/static/img/unio_wordmark.svg" alt="Unio" height="16"/></a>
        </xpath>
    </template>

    <!-- emails -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a target="_blank" href="https://unio.et" t-att-style="'color: ' + (company.email_secondary_color or '#2D6BFF') + ';'">Unio</a>
        </xpath>
    </template>
    <template id="mail_notification_light" inherit_id="mail.mail_notification_light">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a target="_blank" href="https://unio.et" t-att-style="'color: ' + (company.email_secondary_color or '#2D6BFF') + ';'">Unio</a>
        </xpath>
    </template>
    <template id="reset_password_email" inherit_id="auth_signup.reset_password_email">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a target="_blank" href="https://unio.et" t-attf-style="color: {{object.company_id.email_secondary_color or '#2D6BFF'}};">Unio</a>
        </xpath>
    </template>
</odoo>
