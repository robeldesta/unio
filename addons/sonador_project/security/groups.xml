<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_user" model="res.groups">
        <field name="name">Projects: team member</field>
        <field name="comment">Sees the jobs they work on, fills in timesheets and updates their tasks.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Projects: project manager</field>
        <field name="comment">Runs jobs: budgets, bills of quantities, tasks, approves timesheets, prepares billing and certificates.</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
