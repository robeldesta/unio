<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ctl_finding_list" model="ir.ui.view">
        <field name="name">ctl.finding.list</field>
        <field name="model">ctl.finding</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'high' and state in ('open', 'review')" decoration-muted="state in ('resolved', 'dismissed', 'cleared')">
                <field name="severity" widget="badge" decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'"/>
                <field name="name"/>
                <field name="category"/>
                <field name="period" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="confidence" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="last_seen" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'open'" decoration-warning="state == 'review'" decoration-success="state in ('resolved', 'cleared')"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ctl_finding_form" model="ir.ui.view">
        <field name="name">ctl.finding.form</field>
        <field name="model">ctl.finding</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_take" string="Take it" type="object" class="btn-primary" invisible="state not in ('open',)"/>
                    <button name="action_resolve" string="Resolved" type="object" class="btn-primary" invisible="state not in ('open', 'review')"/>
                    <button name="action_dismiss" string="Not a problem" type="object" invisible="state not in ('open', 'review')"
                            help="Write in the resolution note why, then click."/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="state in ('open', 'review')"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,review,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div><field name="category" class="text-muted text-uppercase small" readonly="1"/></div>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="amount" readonly="1"/>
                            <field name="severity" widget="badge" readonly="1" decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'"/>
                            <field name="confidence" readonly="1"/>
                            <field name="confidence_note" readonly="1" nolabel="0"/>
                        </group>
                        <group>
                            <field name="period" readonly="1"/>
                            <label for="metric_current" string="Measure" invisible="not metric_label"/>
                            <div invisible="not metric_label">
                                <field name="metric_label" readonly="1" class="oe_inline"/>:
                                <field name="metric_current" readonly="1" class="oe_inline"/> against
                                <field name="metric_baseline" readonly="1" class="oe_inline"/>
                            </div>
                            <field name="user_id"/>
                            <field name="first_seen" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="What was found"><field name="summary" nolabel="1" colspan="2" readonly="1"/></group>
                    <group string="Where to look"><field name="advice" nolabel="1" colspan="2" readonly="1"/></group>
                    <notebook>
                        <page string="Evidence" name="evidence">
                            <field name="evidence_ids" readonly="1">
                                <list>
                                    <field name="role"/>
                                    <field name="label"/>
                                    <field name="date"/>
                                    <field name="partner" optional="show"/>
                                    <field name="amount"/>
                                    <button name="action_open" type="object" string="Open" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Resolution" name="resolution">
                            <field name="note" placeholder="What was done, or why this is not a problem."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ctl_finding_search" model="ir.ui.view">
        <field name="name">ctl.finding.search</field>
        <field name="model">ctl.finding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category"/>
                <field name="user_id"/>
                <filter name="live" string="Open" domain="[('state', 'in', ('open', 'review'))]"/>
                <filter name="mine" string="Mine" domain="[('user_id', '=', uid)]"/>
                <filter name="high" string="High" domain="[('severity', '=', 'high')]"/>
                <separator/>
                <filter name="closed" string="Resolved, dismissed or cleared" domain="[('state', 'in', ('resolved', 'dismissed', 'cleared'))]"/>
                <group>
                    <filter name="by_check" string="Check" context="{'group_by': 'rule'}"/>
                    <filter name="by_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ctl_findings" model="ir.actions.act_window">
        <field name="name">Findings</field>
        <field name="res_model">ctl.finding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_live': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing needs attention</p>
            <p>The checks run every night. Findings that need someone's attention appear here.</p></field>
    </record>

    <record id="view_ctl_run_list" model="ir.ui.view">
        <field name="name">ctl.run.list</field>
        <field name="model">ctl.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="user_id"/>
                <field name="new" string="New or back"/>
                <field name="open" string="Open after"/>
                <field name="cleared"/>
                <field name="seconds"/>
            </list>
        </field>
    </record>
    <record id="action_ctl_runs" model="ir.actions.act_window">
        <field name="name">Runs</field>
        <field name="res_model">ctl.run</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_ctl_app" model="ir.actions.client">
        <field name="name">Controller</field>
        <field name="tag">sonador_controller.app</field>
    </record>
</odoo>
