<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_operator" model="res.groups">
        <field name="name">Production: floor (operators, supervisors)</field>
        <field name="comment">Runs production orders: starts and stops, records output, waste, downtime and quality checks.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Production: manager</field>
        <field name="comment">Plans orders on the board, finishes and posts them to the books, sets machines, shifts, reasons and checklists.</field>
        <field name="implied_ids" eval="[(4, ref('group_operator'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_viewer" model="res.groups">
        <field name="name">Production: viewer</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees the board, the orders, materials and analytics, and changes nothing. For a general manager or an owner.</field>
    </record>
</odoo>
