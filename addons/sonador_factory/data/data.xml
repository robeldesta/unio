<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_order" model="ir.sequence"><field name="name">Production order</field><field name="code">sb.mfg.order</field><field name="prefix">MO/%(year)s/</field><field name="padding">4</field><field name="company_id" eval="False"/></record>
    <record id="shift_0" model="sb.mfg.shift"><field name="name">Shift A (morning)</field><field name="sequence">0</field><field name="hour_from">6</field><field name="hour_to">14</field></record>
    <record id="shift_1" model="sb.mfg.shift"><field name="name">Shift B (afternoon)</field><field name="sequence">1</field><field name="hour_from">14</field><field name="hour_to">22</field></record>
    <record id="shift_2" model="sb.mfg.shift"><field name="name">Shift C (night)</field><field name="sequence">2</field><field name="hour_from">22</field><field name="hour_to">6</field></record>
    <record id="down_0" model="sb.mfg.reason"><field name="name">Breakdown</field><field name="kind">downtime</field><field name="sequence">0</field><field name="planned" eval="False"/></record>
    <record id="down_1" model="sb.mfg.reason"><field name="name">Changeover / setup</field><field name="kind">downtime</field><field name="sequence">1</field><field name="planned" eval="False"/></record>
    <record id="down_2" model="sb.mfg.reason"><field name="name">Waiting for material</field><field name="kind">downtime</field><field name="sequence">2</field><field name="planned" eval="False"/></record>
    <record id="down_3" model="sb.mfg.reason"><field name="name">Power cut</field><field name="kind">downtime</field><field name="sequence">3</field><field name="planned" eval="False"/></record>
    <record id="down_4" model="sb.mfg.reason"><field name="name">No operator</field><field name="kind">downtime</field><field name="sequence">4</field><field name="planned" eval="False"/></record>
    <record id="down_5" model="sb.mfg.reason"><field name="name">Quality hold</field><field name="kind">downtime</field><field name="sequence">5</field><field name="planned" eval="False"/></record>
    <record id="down_6" model="sb.mfg.reason"><field name="name">Planned maintenance</field><field name="kind">downtime</field><field name="sequence">6</field><field name="planned" eval="True"/></record>
    <record id="down_7" model="sb.mfg.reason"><field name="name">Meal break</field><field name="kind">downtime</field><field name="sequence">7</field><field name="planned" eval="True"/></record>
    <record id="waste_0" model="sb.mfg.reason"><field name="name">Rejects (bad wind, cut or seal)</field><field name="kind">waste</field><field name="sequence">0</field></record>
    <record id="waste_1" model="sb.mfg.reason"><field name="name">Trim and edge (kg)</field><field name="kind">waste</field><field name="sequence">1</field></record>
    <record id="waste_2" model="sb.mfg.reason"><field name="name">Start-up waste</field><field name="kind">waste</field><field name="sequence">2</field></record>
    <record id="waste_3" model="sb.mfg.reason"><field name="name">Damaged in packing</field><field name="kind">waste</field><field name="sequence">3</field></record>
    <record id="waste_4" model="sb.mfg.reason"><field name="name">Broke / reusable (kg)</field><field name="kind">waste</field><field name="sequence">4</field></record>
</odoo>
