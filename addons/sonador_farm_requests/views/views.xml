<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_request_form_farm" model="ir.ui.view">
        <field name="name">sb.purchase.request.form.farm</field>
        <field name="model">sb.purchase.request</field>
        <field name="inherit_id" ref="sonador_requests.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='vendor_id']" position="after">
                <field name="job_id" optional="show" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
