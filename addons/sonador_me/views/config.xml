<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- notifications: who gets what, when, where -->
    <record id="view_notify_rule_list" model="ir.ui.view">
        <field name="name">sb.notify.rule.list</field>
        <field name="model">sb.notify.rule</field>
        <field name="arch" type="xml">
            <list string="Notifications">
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="event"/>
                <field name="kinds" optional="show"/>
                <field name="recipients"/>
                <field name="group_id" optional="show"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="channel"/>
                <field name="timing"/>
                <field name="hour" widget="float_time" optional="show"/>
                <field name="days" optional="show"/>
                <field name="last_run" optional="hide"/>
                <field name="sent_count" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_notify_rule_form" model="ir.ui.view">
        <field name="name">sb.notify.rule.form</field>
        <field name="model">sb.notify.rule</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <header>
                    <button name="action_run_now" type="object" string="Send now" class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Off" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Purchase approvals to Telegram"/></h1></div>
                    <group>
                        <group string="What">
                            <field name="event"/>
                            <field name="kinds" placeholder="all apps"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Who and where">
                            <field name="recipients"/>
                            <field name="group_id" invisible="recipients != 'group'" required="recipients == 'group'"/>
                            <field name="user_ids" widget="many2many_tags" invisible="recipients != 'users'"/>
                            <field name="channel"/>
                        </group>
                        <group string="When">
                            <field name="timing"/>
                            <field name="hour" widget="float_time" invisible="timing != 'daily'"/>
                            <field name="tz" invisible="timing != 'daily'"/>
                            <field name="days" invisible="event not in ('overdue', 'plan_due')"/>
                            <field name="skip_brought_over" invisible="event != 'overdue'"/>
                            <field name="last_run"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sent_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_notify_rule_search" model="ir.ui.view">
        <field name="name">sb.notify.rule.search</field>
        <field name="model">sb.notify.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inactive" string="Off" domain="[('active', '=', False)]"/>
                <group><filter name="by_event" string="Event" context="{'group_by': 'event'}"/>
                    <filter name="by_channel" string="Channel" context="{'group_by': 'channel'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_notify_rules" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">sb.notify.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Say who is told what, when, and where</p>
            <p>One line per message: the event, the people, the channel (Me inbox, email, Telegram) and the time.</p></field>
    </record>

    <!-- approval decisions -->
    <record id="view_approval_log_list" model="ir.ui.view">
        <field name="name">sb.approval.log.list</field>
        <field name="model">sb.approval.log</field>
        <field name="arch" type="xml">
            <list string="Approval decisions" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="app"/>
                <field name="title"/>
                <field name="amount" optional="show"/>
                <field name="decision" decoration-success="decision == 'approved'" decoration-danger="decision == 'sent_back'" widget="badge"/>
                <field name="user_id"/>
                <field name="submitter_id" optional="show"/>
                <field name="note" optional="show"/>
                <field name="channel" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_approval_log_search" model="ir.ui.view">
        <field name="name">sb.approval.log.search</field>
        <field name="model">sb.approval.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/><field name="user_id"/><field name="submitter_id"/>
                <filter name="approved" string="Approved" domain="[('decision', '=', 'approved')]"/>
                <filter name="sent_back" string="Sent back" domain="[('decision', '=', 'sent_back')]"/>
                <group><filter name="by_app" string="App" context="{'group_by': 'app'}"/>
                    <filter name="by_user" string="Decided by" context="{'group_by': 'user_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_approval_log" model="ir.actions.act_window">
        <field name="name">Approval decisions</field>
        <field name="res_model">sb.approval.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_me_config" name="Configuration" parent="menu_me_root" sequence="90" groups="base.group_system"/>
    <menuitem id="menu_me_notify" name="Notifications" parent="menu_me_config" action="action_notify_rules" sequence="10"/>
    <menuitem id="menu_me_log" name="Approval decisions" parent="menu_me_config" action="action_approval_log" sequence="30"/>
</odoo>
