<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_gate" model="res.groups">
        <field name="name">Gate security</field>
        <field name="comment">Sees gate passes waiting at the gate in Me and lets them out.</field>
    </record>
    <record id="rule_log_own" model="ir.rule">
        <field name="name">Approval decisions: mine (decided or submitted)</field>
        <field name="model_id" ref="model_sb_approval_log"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('submitter_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_log_all" model="ir.rule">
        <field name="name">Approval decisions: all (administrators)</field>
        <field name="model_id" ref="model_sb_approval_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_notice_own" model="ir.rule">
        <field name="name">Notices: mine</field>
        <field name="model_id" ref="model_sb_me_notice"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_confirmation_own" model="ir.rule">
        <field name="name">Confirmations: my own</field>
        <field name="model_id" ref="model_sb_confirmation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_confirmation_all" model="ir.rule">
        <field name="name">Confirmations: all (administrators)</field>
        <field name="model_id" ref="model_sb_confirmation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
