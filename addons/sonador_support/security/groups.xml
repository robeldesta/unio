<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_support">
        <field name="name">Support</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="sequence">40</field>
    </record>
    <record id="group_agent" model="res.groups">
        <field name="name">Answers problems (IT / admin)</field>
        <field name="comment">Sees every problem reported, takes, answers and fixes them. Everyone else sees only their own.</field>
        <field name="privilege_id" ref="privilege_support"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
