<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_crm_user" model="res.groups">
        <field name="name">CRM User</field>
        <field name="comment">Works in the CRM (contacts, deals, tasks, visits). Sees no accounting.</field>
        <field name="privilege_id" ref="sonador_sales.privilege_sonador_sales"/>
        <field name="sequence">5</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="sonador_sales.group_sb_sales_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_crm_user'))]"/>
    </record>
    <record id="group_crm_manager" model="res.groups">
        <field name="name">CRM Manager</field>
        <field name="comment">Sees every rep's deals and activity on the dashboard, sets targets, pipelines and stages.</field>
        <field name="privilege_id" ref="sonador_sales.privilege_sonador_sales"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_crm_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
