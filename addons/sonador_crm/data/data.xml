<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="pipe_new" model="sb.crm.pipeline"><field name="name">New customers</field><field name="sequence">1</field></record>
    <record id="pipe_new_s0" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_new"/><field name="name">New lead</field><field name="sequence">0</field><field name="probability">10</field><field name="kind">open</field><field name="rot_days">7</field></record>
    <record id="pipe_new_s1" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_new"/><field name="name">Contacted</field><field name="sequence">1</field><field name="probability">20</field><field name="kind">open</field><field name="rot_days">10</field></record>
    <record id="pipe_new_s2" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_new"/><field name="name">Visit / demo done</field><field name="sequence">2</field><field name="probability">40</field><field name="kind">open</field><field name="rot_days">14</field></record>
    <record id="pipe_new_s3" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_new"/><field name="name">Trial or quotation</field><field name="sequence">3</field><field name="probability">60</field><field name="kind">open</field><field name="rot_days">14</field></record>
    <record id="pipe_new_s4" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_new"/><field name="name">Negotiation</field><field name="sequence">4</field><field name="probability">80</field><field name="kind">open</field><field name="rot_days">10</field></record>
    <record id="pipe_new_s5" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_new"/><field name="name">Won</field><field name="sequence">5</field><field name="probability">100</field><field name="kind">won</field><field name="rot_days">14</field></record>
    <record id="pipe_new_s6" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_new"/><field name="name">Lost</field><field name="sequence">6</field><field name="probability">0</field><field name="kind">lost</field><field name="rot_days">14</field></record>
    <record id="pipe_reorder" model="sb.crm.pipeline"><field name="name">Reorders and accounts</field><field name="sequence">2</field></record>
    <record id="pipe_reorder_s0" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_reorder"/><field name="name">Reorder due</field><field name="sequence">0</field><field name="probability">30</field><field name="kind">open</field><field name="rot_days">10</field></record>
    <record id="pipe_reorder_s1" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_reorder"/><field name="name">Pitched</field><field name="sequence">1</field><field name="probability">50</field><field name="kind">open</field><field name="rot_days">10</field></record>
    <record id="pipe_reorder_s2" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_reorder"/><field name="name">Committed</field><field name="sequence">2</field><field name="probability">80</field><field name="kind">open</field><field name="rot_days">14</field></record>
    <record id="pipe_reorder_s3" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_reorder"/><field name="name">Won</field><field name="sequence">3</field><field name="probability">100</field><field name="kind">won</field><field name="rot_days">14</field></record>
    <record id="pipe_reorder_s4" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_reorder"/><field name="name">Lost</field><field name="sequence">4</field><field name="probability">0</field><field name="kind">lost</field><field name="rot_days">14</field></record>
    <record id="pipe_tender" model="sb.crm.pipeline"><field name="name">Tenders and projects</field><field name="sequence">3</field></record>
    <record id="pipe_tender_s0" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_tender"/><field name="name">Tender announced</field><field name="sequence">0</field><field name="probability">10</field><field name="kind">open</field><field name="rot_days">14</field></record>
    <record id="pipe_tender_s1" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_tender"/><field name="name">Documents bought</field><field name="sequence">1</field><field name="probability">20</field><field name="kind">open</field><field name="rot_days">14</field></record>
    <record id="pipe_tender_s2" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_tender"/><field name="name">Bid submitted (with CPO / bid bond)</field><field name="sequence">2</field><field name="probability">40</field><field name="kind">open</field><field name="rot_days">30</field></record>
    <record id="pipe_tender_s3" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_tender"/><field name="name">Bid opening / evaluation</field><field name="sequence">3</field><field name="probability">60</field><field name="kind">open</field><field name="rot_days">30</field></record>
    <record id="pipe_tender_s4" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_tender"/><field name="name">Won</field><field name="sequence">4</field><field name="probability">100</field><field name="kind">won</field><field name="rot_days">14</field></record>
    <record id="pipe_tender_s5" model="sb.crm.stage"><field name="pipeline_id" ref="pipe_tender"/><field name="name">Lost</field><field name="sequence">5</field><field name="probability">0</field><field name="kind">lost</field><field name="rot_days">14</field></record>
    <record id="lost_0" model="sb.crm.lost.reason"><field name="name">Price too high</field><field name="sequence">0</field></record>
    <record id="lost_1" model="sb.crm.lost.reason"><field name="name">Bought from a competitor</field><field name="sequence">1</field></record>
    <record id="lost_2" model="sb.crm.lost.reason"><field name="name">No money now / needs credit</field><field name="sequence">2</field></record>
    <record id="lost_3" model="sb.crm.lost.reason"><field name="name">Not the season</field><field name="sequence">3</field></record>
    <record id="lost_4" model="sb.crm.lost.reason"><field name="name">Gets it through the cooperative union / government</field><field name="sequence">4</field></record>
    <record id="lost_5" model="sb.crm.lost.reason"><field name="name">Cannot deliver there (road, distance)</field><field name="sequence">5</field></record>
    <record id="lost_6" model="sb.crm.lost.reason"><field name="name">No response</field><field name="sequence">6</field></record>
    <record id="lost_7" model="sb.crm.lost.reason"><field name="name">Product not suitable</field><field name="sequence">7</field></record>
    <record id="lost_8" model="sb.crm.lost.reason"><field name="name">Tender: not responsive / lost on price</field><field name="sequence">8</field></record>
    <record id="lost_9" model="sb.crm.lost.reason"><field name="name">Other</field><field name="sequence">9</field></record>
</odoo>
