<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_crm_home" model="ir.actions.client">
        <field name="name">CRM</field>
        <field name="tag">sonador_crm.app</field>
        <field name="params" eval="{'page': 'home'}"/>
    </record>
    <record id="action_crm_contacts" model="ir.actions.client">
        <field name="name">Contacts</field>
        <field name="tag">sonador_crm.app</field>
        <field name="params" eval="{'page': 'contacts'}"/>
    </record>
    <record id="action_crm_deals" model="ir.actions.client">
        <field name="name">Deals</field>
        <field name="tag">sonador_crm.app</field>
        <field name="params" eval="{'page': 'deals'}"/>
    </record>
    <record id="action_crm_tasks" model="ir.actions.client">
        <field name="name">My day</field>
        <field name="tag">sonador_crm.app</field>
        <field name="params" eval="{'page': 'tasks'}"/>
    </record>
    <record id="action_crm_reorders" model="ir.actions.client">
        <field name="name">Reorders due</field>
        <field name="tag">sonador_crm.app</field>
        <field name="params" eval="{'page': 'reorders'}"/>
    </record>
    <menuitem id="menu_crm_root" name="CRM" sequence="20" web_icon="sonador_crm,static/description/icon.png"
              groups="group_crm_user"/>
    <menuitem id="menu_crm_home" name="Dashboard" parent="menu_crm_root" action="action_crm_home" sequence="1"/>
    <menuitem id="menu_crm_tasks" name="My day" parent="menu_crm_root" action="action_crm_tasks" sequence="2"/>
    <menuitem id="menu_crm_contacts" name="Contacts" parent="menu_crm_root" action="action_crm_contacts" sequence="3"/>
    <menuitem id="menu_crm_deals" name="Deals" parent="menu_crm_root" action="action_crm_deals" sequence="4"/>
    <menuitem id="menu_crm_reorders" name="Reorders due" parent="menu_crm_root" action="action_crm_reorders" sequence="5"/>
</odoo>
