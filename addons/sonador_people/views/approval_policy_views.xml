<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_sb_approvals" model="ir.ui.view">
        <field name="name">res.company.form.sb.approvals</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Approvals" name="sb_approvals">
                    <group>
                        <field name="sb_self_approval"/>
                        <field name="sb_gm_own_approver_id" options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
