<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_people_home" model="ir.actions.client">
        <field name="name">People</field>
        <field name="tag">sonador_people.app</field>
        <field name="params" eval="{'page': 'home'}"/>
    </record>
    <record id="action_people_directory" model="ir.actions.client">
        <field name="name">Directory</field>
        <field name="tag">sonador_people.app</field>
        <field name="params" eval="{'page': 'directory'}"/>
    </record>
    <record id="action_people_org" model="ir.actions.client">
        <field name="name">Org Chart</field>
        <field name="tag">sonador_people.app</field>
        <field name="params" eval="{'page': 'org'}"/>
    </record>
    <record id="action_people_me" model="ir.actions.client">
        <field name="name">My Profile</field>
        <field name="tag">sonador_people.app</field>
        <field name="params" eval="{'page': 'me'}"/>
    </record>
    <record id="action_departments" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_jobs" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">hr.job</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_departure_reasons" model="ir.actions.act_window">
        <field name="name">Reasons for Leaving</field>
        <field name="res_model">hr.departure.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- the Employees app becomes People, for everyone (directory, my profile); HR sees the rest -->
    <record id="sonador_books.menu_hr_root" model="ir.ui.menu">
        <field name="name">People</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>
    <record id="sonador_books.menu_hr_employees" model="ir.ui.menu">
        <field name="name">Payroll Profiles</field>
        <field name="sequence">90</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>
    <menuitem id="menu_people_home" name="Home" parent="sonador_books.menu_hr_root" action="action_people_home" sequence="1"/>
    <menuitem id="menu_people_directory" name="Directory" parent="sonador_books.menu_hr_root" action="action_people_directory" sequence="2"/>
    <menuitem id="menu_people_org" name="Org Chart" parent="sonador_books.menu_hr_root" action="action_people_org" sequence="3"/>
    <menuitem id="menu_people_me" name="My Profile" parent="sonador_books.menu_hr_root" action="action_people_me" sequence="4"/>
    <menuitem id="menu_people_config" name="Configuration" parent="sonador_books.menu_hr_root" sequence="80"
              groups="sonador_books.group_sb_hr"/>
    <menuitem id="menu_people_departments" name="Departments" parent="menu_people_config" action="action_departments" sequence="1"/>
    <menuitem id="menu_people_jobs" name="Positions" parent="menu_people_config" action="action_jobs" sequence="2"/>
    <menuitem id="menu_people_reasons" name="Reasons for Leaving" parent="menu_people_config" action="action_departure_reasons" sequence="3"/>
    <record id="sonador_books.menu_hr_users" model="ir.ui.menu">
        <field name="parent_id" ref="menu_people_config"/>
    </record>

    <!-- one People app: Odoo's own Employees app is hidden -->
    <function model="sb.people" name="_hide_odoo_hr"/>
</odoo>
