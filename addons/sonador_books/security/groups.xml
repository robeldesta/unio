<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_sonador_books">
        <field name="name">Accounting</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">6</field>
    </record>
    <record id="group_sb_auditor" model="res.groups">
        <field name="name">Auditor (read-only)</field>
        <field name="sequence">10</field>
        <field name="comment">Sees every voucher, ledger and report and can export them. Cannot enter or change anything.</field>
        <field name="privilege_id" ref="privilege_sonador_books"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="group_sb_clerk" model="res.groups">
        <field name="name">Clerk</field>
        <field name="sequence">20</field>
        <field name="comment">Enters and posts day-to-day vouchers: cash sales, invoices, receipts, purchase vouchers, payments, transfers. Cannot edit or void posted vouchers, post journal vouchers, reconcile banks or close periods.</field>
        <field name="privilege_id" ref="privilege_sonador_books"/>
        <field name="implied_ids" eval="[(4, ref('group_sb_auditor')), (4, ref('account.group_account_invoice'))]"/>
    </record>
    <!-- everyone may export what they can see (Action > Export, Excel or CSV): export follows the same access rights as
         the list itself, so it never shows a person more than their role does (a function: base keeps its group as noupdate) -->
    <function model="res.groups" name="write">
        <value eval="[ref('base.group_user')]"/>
        <value eval="{'implied_ids': [(4, ref('base.group_allow_export'))]}"/>
    </function>
    <record id="group_sb_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">30</field>
        <field name="comment">Everything a clerk does, plus journal vouchers, opening balances, editing and voiding posted vouchers, cheques, bank reconciliation, finance charges.</field>
        <field name="privilege_id" ref="privilege_sonador_books"/>
        <field name="implied_ids" eval="[(4, ref('group_sb_clerk')), (4, ref('account.group_account_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>
    <record id="group_sb_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">40</field>
        <field name="comment">Everything an accountant does, plus closing and reopening periods, the year-end wizard, settings, the chart of accounts and IFRS mapping.</field>
        <field name="privilege_id" ref="privilege_sonador_books"/>
        <field name="implied_ids" eval="[(4, ref('group_sb_accountant')), (4, ref('account.group_account_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_sb_legacy_apps" model="res.groups">
        <field name="name">Show standard Odoo apps (Invoicing, Inventory, Dashboards)</field>
        <field name="comment">Accounting replaces these apps, so their menus are hidden. Add a user here only when they need the raw Odoo screens.</field>
    </record>
</odoo>
