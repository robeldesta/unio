<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_journal_form_sb_register" model="ir.ui.view">
        <field name="name">account.journal.form.sb_register</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="sb_register"/>
            </field>
        </field>
    </record>
    <record id="view_journal_list_sb_register" model="ir.ui.view">
        <field name="name">account.journal.list.sb_register</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="sb_register" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
