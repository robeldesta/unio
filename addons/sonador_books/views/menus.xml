    <menuitem id="menu_sb_cheques" name="Cheques" parent="menu_sb_banking" action="action_sb_cheques" sequence="4"/>
    <menuitem id="menu_sb_bank_accounts" name="Bank &amp; Cash Accounts" parent="menu_sb_banking" action="action_sb_bank_accounts" sequence="20"/>
    <menuitem id="menu_sb_bank_book" name="Cash and Bank Book" parent="menu_sb_banking" action="action_sb_rep_cash_book" sequence="10"/>

    <menuitem id="menu_sb_payroll_root" name="Payroll" parent="menu_sb_root" sequence="35"/>
    <menuitem id="menu_sb_payroll" name="Payroll Runs" parent="menu_sb_payroll_root" action="action_sb_payroll" sequence="1"/>
    <menuitem id="menu_sb_employees" name="Employees" parent="menu_sb_payroll_root" action="action_sb_employees" sequence="2"/>
    <menuitem id="menu_sb_payroll_brackets" name="Income Tax Table" parent="menu_sb_payroll_root" action="action_sb_payroll_brackets" sequence="10"
              groups="sonador_books.group_sb_manager"/>

    <menuitem id="menu_sb_inventory" name="Inventory &amp; Costing" parent="menu_sb_root" sequence="30"/>
    <menuitem id="menu_sb_products" name="Inventory Items" parent="menu_sb_inventory" action="action_sb_products" sequence="1"/>
