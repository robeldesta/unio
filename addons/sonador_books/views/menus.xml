<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sb_nav_center" model="ir.actions.client">
        <field name="name">Navigation Center</field>
        <field name="tag">sonador_books.nav_center</field>
    </record>

    <record id="action_sb_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'res_partner_search_mode': 'customer', 'default_customer_rank': 1}</field>
    </record>
    <record id="action_sb_vendors" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1}</field>
    </record>
    <record id="action_sb_products" model="ir.actions.act_window">
        <field name="name">Inventory Items</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <record id="action_sb_product_categories" model="ir.actions.act_window">
        <field name="name">Item Classes and Costing</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_sb_journal_items" model="ir.actions.act_window">
        <field name="name">General Ledger Lines</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('parent_state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_by_account': 1}</field>
    </record>
    <record id="action_sb_deferred_revenue" model="ir.actions.act_window">
        <field name="name">Deferred Revenue (IFRS 15)</field>
        <field name="res_model">account.asset.asset</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category_id.type', '=', 'sale')]</field>
        <field name="context">{'default_type': 'sale'}</field>
    </record>
    <record id="action_sb_deferred_revenue_types" model="ir.actions.act_window">
        <field name="name">Deferred Revenue Types</field>
        <field name="res_model">account.asset.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'sale')]</field>
        <field name="context">{'default_type': 'sale'}</field>
    </record>

    <menuitem id="menu_sb_root" name="Accounting" sequence="24"
              web_icon="sonador_books,static/description/icon.png"
              groups="sonador_books.group_sb_auditor"/>
    <menuitem id="menu_sb_home" name="Home" parent="menu_sb_root" action="action_sb_nav_center" sequence="1"/>

    <menuitem id="menu_sb_customers" name="Customers &amp; Sales" parent="menu_sb_root" sequence="10"/>
    <menuitem id="menu_sb_customers_list" name="Customers" parent="menu_sb_customers" action="action_sb_customers" sequence="1"/>
    <menuitem id="menu_sb_cash_sale" name="Cash Sales" parent="menu_sb_customers" action="action_sb_cash_sale" sequence="5"/>
    <menuitem id="menu_sb_sale" name="Sales Invoices (on account)" parent="menu_sb_customers" action="action_sb_sale" sequence="10"/>
    <menuitem id="menu_sb_receipt" name="Receipts (CRV)" parent="menu_sb_customers" action="action_sb_receipt" sequence="20"/>
    <menuitem id="menu_sb_finance_charge" groups="sonador_books.group_sb_accountant" name="Finance Charges" parent="menu_sb_customers" action="action_sb_finance_charge" sequence="40"/>
    <menuitem id="menu_sb_sale_return" name="Sales Returns / Credit Notes" parent="menu_sb_customers" action="action_sb_sale_return" sequence="30"/>

    <menuitem id="menu_sb_vendors" name="Vendors &amp; Purchases" parent="menu_sb_root" sequence="20"/>
    <menuitem id="menu_sb_vendors_list" name="Vendors" parent="menu_sb_vendors" action="action_sb_vendors" sequence="1"/>
    <menuitem id="menu_sb_cash_purchase" name="Cash Purchases" parent="menu_sb_vendors" action="action_sb_cash_purchase" sequence="5"/>
    <menuitem id="menu_sb_bill" name="Purchase Bills (on account)" parent="menu_sb_vendors" action="action_sb_bill" sequence="10"/>
    <menuitem id="menu_sb_payment" name="Payments (CPV)" parent="menu_sb_vendors" action="action_sb_payment" sequence="20"/>
    <menuitem id="menu_sb_batch_payment" groups="sonador_books.group_sb_accountant" name="Pay Several Bills" parent="menu_sb_vendors" action="action_sb_batch_payment" sequence="25"/>
    <menuitem id="menu_sb_purchase_return" name="Purchase Returns / Debit Notes" parent="menu_sb_vendors" action="action_sb_purchase_return" sequence="30"/>

