    <menuitem id="menu_sb_chart" name="Chart of Accounts" parent="menu_sb_gl" action="action_sb_chart" sequence="10"/>
    <menuitem id="menu_sb_opening" groups="sonador_books.group_sb_accountant" name="Beginning Balances" parent="menu_sb_gl" action="action_sb_beginning" sequence="15"/>
    <menuitem id="menu_sb_opening_entries" groups="sonador_books.group_sb_accountant" name="Beginning Balance Entries" parent="menu_sb_gl" action="action_sb_opening" sequence="16"/>
