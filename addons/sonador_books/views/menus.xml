    <menuitem id="menu_sb_bank_receipts" name="Receipts (CRV)" parent="menu_sb_banking" action="action_sb_receipt" sequence="1"/>
    <menuitem id="menu_sb_bank_payments" name="Payments (CPV)" parent="menu_sb_banking" action="action_sb_payment" sequence="2"/>
