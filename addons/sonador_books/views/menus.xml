    <menuitem id="menu_sb_setup" name="Setup" parent="menu_sb_root" sequence="90"/>
    <menuitem id="menu_sb_setup_guide" name="Setup Guide" parent="menu_sb_setup" action="action_sb_setup_guide" sequence="0"/>
    <menuitem id="menu_sb_periods" name="Accounting Periods" parent="menu_sb_setup" action="action_sb_periods_open" sequence="1"/>
    <menuitem id="menu_sb_year_end" name="Year-End Closing" parent="menu_sb_setup" action="action_sb_year_end" sequence="2"
