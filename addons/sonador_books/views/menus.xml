        <field name="tag">sonador_books.fx</field>
    </record>
    <menuitem id="menu_sb_fx" groups="sonador_books.group_sb_accountant" name="Currencies and Revaluation" parent="menu_sb_gl" action="action_sb_fx" sequence="35"/>
    <menuitem id="menu_sb_deferred" name="Deferred Revenue (IFRS 15)" parent="menu_sb_gl" action="action_sb_deferred_revenue" sequence="40"/>

