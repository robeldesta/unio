    <menuitem id="menu_sb_ifrs_lines" name="IFRS Line Items" parent="menu_sb_setup" action="action_sb_ifrs_line" sequence="10"/>
    <menuitem id="menu_sb_ifrs_check" name="IFRS Mapping Check" parent="menu_sb_setup" action="action_sb_ifrs_check" sequence="11"/>
    <menuitem id="menu_sb_asset_types" name="Asset Types" parent="menu_sb_setup" action="om_account_asset.action_account_asset_asset_list_normal_purchase" sequence="20"/>
