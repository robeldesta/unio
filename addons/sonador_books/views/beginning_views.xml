<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sb_beginning" model="ir.actions.client">
        <field name="name">Beginning Balances</field>
        <field name="tag">sonador_books.beginning_balances</field>
    </record>

    <record id="view_partner_form_sb_history" model="ir.ui.view">
        <field name="name">res.partner.form.sb.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='internal_notes']" position="before">
                <page string="History" name="sb_history" invisible="parent_id">
                    <widget name="sb_partner_history"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_sb_license" model="ir.ui.view">
        <field name="name">res.partner.form.sb.license</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="sb_books_country" invisible="1"/>
                <field name="sb_trade_license" invisible="not is_company or parent_id or sb_books_country != 'ET'"/>
                <field name="sb_wht_exempt_until" invisible="parent_id or sb_books_country != 'UG'"/>
            </field>
        </field>
    </record>

    <record id="view_account_form_sb_beginning" model="ir.ui.view">
        <field name="name">account.account.form.sb.beginning</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="reconcile" invisible="account_type in ('asset_cash', 'liability_credit_card', 'off_balance')"/>
                <field name="sb_partner_account" invisible="account_type in ('asset_cash', 'liability_credit_card', 'off_balance', 'asset_receivable', 'liability_payable')"/>
                <field name="sb_liability_group" invisible="not account_type or not account_type.startswith('liability')"/>
                <field name="sb_partner_side" invisible="not sb_partner_side and not sb_partner_account and account_type not in ('asset_receivable', 'liability_payable')"/>
                <field name="sb_overdraft_control" invisible="account_type != 'asset_cash'"/>
                <field name="sb_custodian_id" invisible="account_type != 'asset_cash'" options="{'no_create': True}"/>
                <field name="sb_overdraft_limit" invisible="account_type != 'asset_cash' or not sb_overdraft_control"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_sb_beginning" type="object" class="oe_stat_button" icon="fa-flag-o"
                        groups="sonador_books.group_sb_accountant">
                    <div class="o_stat_info"><span class="o_stat_text">Beginning</span><span class="o_stat_text">Balances</span></div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
