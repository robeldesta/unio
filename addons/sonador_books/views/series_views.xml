<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sb_doc_series_list" model="ir.ui.view">
        <field name="name">sb.doc.series.list</field>
        <field name="model">sb.doc.series</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="doc_type"/>
                <field name="kind" optional="show"/>
                <field name="name"/>
                <field name="prefix"/>
                <field name="suffix" optional="show"/>
                <field name="next_preview"/>
                <field name="number_to" optional="show"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="sb_doc_series_form" model="ir.ui.view">
        <field name="name">sb.doc.series.form</field>
        <field name="model">sb.doc.series</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_spoil" type="object" string="Record Spoiled Numbers" icon="fa-ban"
                            groups="sonador_books.group_sb_accountant"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Cash register 2, Invoice pad B, DRM GRN book"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="doc_type"/>
                            <field name="kind" invisible="doc_type not in ('grn', 'giv')"/>
                            <field name="is_default"/>
                            <field name="active"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="prefix" placeholder="FS, INV-A/, CRV/{fy}/ ..."/>
                            <field name="suffix" placeholder="/FPDV (optional)"/>
                            <field name="padding"/>
                            <field name="number_from"/>
                            <field name="number_to"/>
                            <field name="sb_open_numbering"/>
                            <field name="next_preview" string="Next number"/>
                        </group>
                    </group>
                    <div class="text-muted small mb-3">
                        Numbers are taken only when a document is posted (confirmed for orders), strictly one after the other.
                        A number the pad or cash register used up without a document must be recorded as spoiled, so nothing is ever skipped.
                    </div>
                    <notebook>
                        <page string="Counters" name="counters">
                            <field name="counter_ids" groups="sonador_books.group_sb_manager">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="key"/>
                                    <field name="next_number"/>
                                </list>
                            </field>
                        </page>
                        <page string="Spoiled numbers" name="spoiled">
                            <field name="spoil_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="number_from"/>
                                    <field name="number_to"/>
                                    <field name="count"/>
                                    <field name="reason"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sb_doc_series_spoil_form" model="ir.ui.view">
        <field name="name">sb.doc.series.spoil.form</field>
        <field name="model">sb.doc.series.spoil</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="series_id" readonly="1"/>
                    <field name="date"/>
                    <field name="count" string="How many numbers"/>
                    <field name="reason" placeholder="Torn, misprinted, cancelled on the cash register ..."/>
                </group>
                <div class="text-muted small">The next numbers of the series are used up, in order, starting from the next number.</div>
                <footer>
                    <button string="Record" special="save" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sb_doc_series" model="ir.actions.act_window">
        <field name="name">Document Series (pads)</field>
        <field name="res_model">sb.doc.series</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="action_sb_rep_numbering" model="ir.actions.client">
        <field name="name">Document Numbering Check</field>
        <field name="tag">sonador_books.report</field>
        <field name="context">{'report': 'numbering', 'catalog_key': 'numbering'}</field>
    </record>

    <record id="sb_voucher_form_series" model="ir.ui.view">
        <field name="name">sb.voucher.form.series</field>
        <field name="model">sb.voucher</field>
        <field name="inherit_id" ref="sb_voucher_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_ec']/../.." position="after">
                <field name="sb_fiscal_only" invisible="1"/>
                <field name="sb_series_id" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"
                       invisible="sb_fiscal_only or voucher_type not in ('sale', 'cash_sale', 'sale_return', 'receipt', 'payment', 'journal') or (state != 'draft' and not sb_series_id)"/>
                <field name="sb_series_open" invisible="1"/>
                <field name="sb_pad_number" readonly="state != 'draft'"
                       invisible="sb_fiscal_only or sb_series_open or voucher_type not in ('sale', 'cash_sale', 'sale_return', 'receipt', 'payment', 'journal') or state != 'draft'"
                       placeholder="as printed on the pad (optional)"/>
                <field name="sb_pad_number" string="Fiscal receipt / e-invoice no." readonly="state != 'draft'"
                       invisible="not sb_fiscal_only or state != 'draft'"
                       decoration-danger="sb_fiscal_bad"
                       placeholder="e.g. FS00001954, or the Ministry e-invoice reference"/>
                <field name="sb_pad_number" string="Number" readonly="state != 'draft'"
                       invisible="sb_fiscal_only or not sb_series_open or state != 'draft'"
                       placeholder="any number, e.g. JV/TB/SENE2054 (blank: the next number)"/>
                <field name="sb_fiscal_bad" invisible="1"/>
                <div colspan="2" invisible="not sb_fiscal_hint" class="small mb-2">
                    <field name="sb_fiscal_hint" nolabel="1" class="d-inline" decoration-danger="sb_fiscal_bad" decoration-muted="not sb_fiscal_bad"/>
                </div>
            </xpath>
        </field>
    </record>

    <function model="sb.doc.series" name="_ensure_defaults"/>
</odoo>
