<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_a5" model="report.paperformat">
        <field name="name">A5 portrait (documents)</field>
        <field name="format">A5</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field><field name="margin_bottom">8</field>
        <field name="margin_left">7</field><field name="margin_right">7</field>
        <field name="header_spacing">0</field><field name="dpi">96</field>
    </record>
    <record id="paperformat_a4" model="report.paperformat">
        <field name="name">A4 portrait (documents)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field><field name="margin_bottom">12</field>
        <field name="margin_left">11</field><field name="margin_right">11</field>
        <field name="header_spacing">0</field><field name="dpi">96</field>
    </record>
    <record id="paperformat_receipt" model="report.paperformat">
        <field name="name">Receipt 80 mm</field>
        <field name="format">custom</field>
        <field name="page_width">80</field>
        <field name="page_height">297</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field><field name="margin_bottom">3</field>
        <field name="margin_left">3</field><field name="margin_right">3</field>
        <field name="header_spacing">0</field><field name="dpi">96</field>
    </record>

    <record id="action_print_a4" model="ir.actions.report">
        <field name="name">Document (A4)</field>
        <field name="model">sb.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sonador_print.document_a4</field>
        <field name="report_file">sonador_print.document_a4</field>
        <field name="paperformat_id" ref="paperformat_a4"/>
    </record>
    <record id="action_print_a5" model="ir.actions.report">
        <field name="name">Document (A5)</field>
        <field name="model">sb.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sonador_print.document_a5</field>
        <field name="report_file">sonador_print.document_a5</field>
        <field name="paperformat_id" ref="paperformat_a5"/>
    </record>
    <record id="action_print_receipt" model="ir.actions.report">
        <field name="name">Document (receipt)</field>
        <field name="model">sb.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sonador_print.document_receipt</field>
        <field name="report_file">sonador_print.document_receipt</field>
        <field name="paperformat_id" ref="paperformat_receipt"/>
    </record>

    <!-- one report name per paper: Odoo finds reports by name, so they cannot share one -->
    <template id="document_a4"><t t-call="sonador_print.document"/></template>
    <template id="document_a5"><t t-call="sonador_print.document"/></template>
    <template id="document_receipt"><t t-call="sonador_print.document"/></template>

    <template id="document">
        <t t-call="web.html_container">
            <t t-foreach="pages" t-as="d">
                <t t-set="st" t-value="d['style']"/>
                <t t-set="co" t-value="d['company']"/>
                <t t-set="receipt" t-value="st.get('paper') == 'receipt'"/>
                <t t-set="tpl" t-value="'receipt' if receipt else st.get('template', 'modern')"/>
                <t t-set="font" t-value="d['font_css']"/>
                <t t-set="lang" t-value="st.get('lang', 'en')"/>
                <t t-set="tr" t-value="d['t']"/>
                <t t-set="title" t-value="(d['title_am'] if lang == 'am' else (d['title'] + ' · ' + d['title_am']) if lang == 'both' else d['title'])"/>
                <div t-attf-class="article sbp sbp-{{ tpl }}" t-att-data-oe-model="d['record']._name" t-att-data-oe-id="d['record'].id"
                     t-attf-style="font-family: {{ font }};">
                    <!-- wkhtmltopdf has no CSS variables: the colours are put in as text -->
                    <t t-set="css">
                        .sbp { color: #1d2333; font-size: 11.5px; line-height: 1.45; position: relative; }
                        .sbp-compact { font-size: 10px; }
                        .sbp-receipt { font-size: 9.5px; }
                        .sbp h1 { margin: 0; font-size: 22px; letter-spacing: -0.2px; color: var(--c); }
                        .sbp-bold h1 { font-size: 30px; text-transform: uppercase; letter-spacing: 1px; }
                        .sbp-receipt h1 { font-size: 14px; text-align: center; }
                        .sbp .top { display: table; width: 100%; margin-bottom: 14px; }
                        .sbp .top > div { display: table-cell; vertical-align: top; }
                        .sbp .co-name { font-weight: 700; font-size: 14px; color: var(--c); }
                        .sbp .muted { color: #6b7286; }
                        .sbp .band { background: var(--c); color: #fff; padding: 12px 14px; border-radius: 6px; margin-bottom: 14px; }
                        .sbp .band h1 { color: #fff; }
                        .sbp .band .muted { color: rgba(255,255,255,.75); }
                        .sbp-bold .band { background: var(--a); }
                        .sbp .mark { display: inline-block; border: 2px solid #c0392b; color: #c0392b; font-weight: 700; padding: 1px 8px; border-radius: 4px; letter-spacing: 1px; }
                        .sbp .copy { text-align: right; font-size: 10px; font-weight: 700; color: var(--a); letter-spacing: 2px; margin-bottom: 4px; }
                        .sbp .parties { display: table; width: 100%; margin-bottom: 12px; }
                        .sbp .parties > div { display: table-cell; vertical-align: top; width: 50%; }
                        .sbp .lbl { font-size: 9px; text-transform: uppercase; letter-spacing: 1px; color: #8a90a2; }
                        .sbp .pname { font-weight: 700; font-size: 13px; }
                        .sbp table.lines { width: 100%; border-collapse: collapse; margin: 6px 0 10px; }
                        .sbp table.lines th { text-align: left; font-size: 9.5px; text-transform: uppercase; letter-spacing: .6px; padding: 6px 6px; color: var(--c); border-bottom: 2px solid var(--c); }
                        .sbp-modern table.lines th, .sbp-bold table.lines th { background: var(--c); color: #fff; border: 0; }
                        .sbp table.lines th.r { text-align: right; }
                        .sbp-classic table.lines th, .sbp-classic table.lines td { border: 1px solid #cfd3de; }
                        .sbp table.lines td { padding: 5px 6px; border-bottom: 1px solid #e6e8ef; vertical-align: top; }
                        .sbp-modern table.lines tr:nth-child(even) td { background: #f6f7fb; }
                        .sbp-receipt table.lines th, .sbp-receipt table.lines td { padding: 2px 1px; }
                        .sbp .r { text-align: right; white-space: nowrap; }
                        .sbp .code { color: #8a90a2; font-size: 9px; }
                        .sbp .bottom { display: table; width: 100%; }
                        .sbp .bottom > div { display: table-cell; vertical-align: top; }
                        .sbp table.totals { width: 100%; border-collapse: collapse; }
                        .sbp table.totals td { padding: 3px 6px; }
                        .sbp table.totals tr.strong td { font-weight: 700; font-size: 13px; border-top: 2px solid var(--c); color: var(--c); }
                        .sbp-bold table.totals tr.strong td { background: var(--a); color: #fff; border: 0; }
                        .sbp .meta td { padding: 1px 0 1px 10px; }
                        .sbp .sig { display: table; width: 100%; margin-top: 28px; }
                        .sbp .sig > div { display: table-cell; padding-right: 14px; }
                        .sbp .sig .line { border-top: 1px solid #333; padding-top: 3px; font-weight: 600; }
                        .sbp .stamp { width: 110px; height: 70px; border: 1px dashed #aab; border-radius: 6px; color: #aab; text-align: center; padding-top: 26px; font-size: 9px; }
                        .sbp .foot { margin-top: 16px; padding-top: 6px; border-top: 1px solid #e0e3ec; color: #6b7286; font-size: 9.5px; text-align: center; }
                        .sbp img.logo { max-height: 62px; max-width: 200px; }
                        .sbp-receipt img.logo { max-height: 40px; display: block; margin: 0 auto 4px; }
                        .sbp-receipt .center { text-align: center; }
                        .sbp-receipt .parties > div, .sbp-receipt .sig > div { display: block; width: auto; }
                        .sbp-receipt .meta td { padding-left: 0; padding-right: 8px; }
                        .sbp-receipt .sig { margin-top: 10px; }
                        .sbp-receipt .sig > div { padding: 14px 0 0; }
                    </t>
                    <style t-if="d['font_face']" t-out="d['font_face']"/>
                    <style t-out="css.replace('var(--c)', d['colors'][0]).replace('var(--a)', d['colors'][1])"/>

                    <div t-if="st.get('show_copy_label')" class="copy" t-esc="tr('ORIGINAL')"/>

                    <!-- header -->
                    <t t-if="receipt">
                        <div class="center">
                            <img t-if="st.get('show_logo') and co['logo']" class="logo" t-att-src="image_data_uri(co['logo'])"/>
                            <div class="co-name" t-esc="co['name']"/>
                            <div t-if="st.get('show_company_address')" class="muted"><t t-esc="co['address']"/><br t-if="co['phone']"/><t t-esc="co['phone']"/></div>
                            <div t-if="st.get('show_tin') and co['tin']"><t t-esc="tr('TIN')"/> <t t-esc="co['tin']"/></div>
                            <h1 style="margin-top:6px" t-esc="title"/>
                            <div><b t-esc="d['number']"/> · <t t-esc="d['date']"/><t t-if="d['date_ec']"> · <t t-esc="d['date_ec']"/></t></div>
                            <div t-if="d['status_mark']" class="mark" t-esc="d['status_mark']"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div t-if="tpl in ('modern', 'bold')" class="band">
                            <div class="top" style="margin:0">
                                <div t-if="st.get('logo_position') != 'right'" style="width:1%; padding-right:14px">
                                    <img t-if="st.get('show_logo') and co['logo']" class="logo" style="background:#fff; padding:4px; border-radius:4px" t-att-src="image_data_uri(co['logo'])"/>
                                </div>
                                <div>
                                    <h1 t-esc="title"/>
                                    <div class="muted"><t t-esc="co['name']"/><t t-if="st.get('show_tin') and co['tin']"> · <t t-esc="tr('TIN')"/> <t t-esc="co['tin']"/></t></div>
                                </div>
                                <div style="text-align:right">
                                    <div style="font-size:15px; font-weight:700" t-esc="d['number']"/>
                                    <div><t t-esc="d['date']"/></div>
                                    <div t-if="d['date_ec']" class="muted" t-esc="d['date_ec']"/>
                                </div>
                                <div t-if="st.get('logo_position') == 'right'" style="width:1%; padding-left:14px">
                                    <img t-if="st.get('show_logo') and co['logo']" class="logo" style="background:#fff; padding:4px; border-radius:4px" t-att-src="image_data_uri(co['logo'])"/>
                                </div>
                            </div>
                        </div>
                        <div t-else="" class="top" t-attf-style="border-bottom: 2px solid {{ d['colors'][0] }}; padding-bottom: 8px; {{ 'text-align:center' if st.get('logo_position') == 'center' else '' }}">
                            <div t-attf-style="{{ 'text-align:right' if st.get('logo_position') == 'right' else '' }}">
                                <img t-if="st.get('show_logo') and co['logo']" class="logo" t-att-src="image_data_uri(co['logo'])"/>
                                <div class="co-name" t-esc="co['name']"/>
                                <div t-if="st.get('show_company_address')" class="muted"><t t-esc="co['address']"/><t t-if="co['phone']"> · <t t-esc="co['phone']"/></t><t t-if="co['email']"> · <t t-esc="co['email']"/></t></div>
                                <div t-if="st.get('show_tin') and co['tin']" class="muted"><t t-esc="tr('TIN')"/> <t t-esc="co['tin']"/><t t-if="co['vat_no']"> · <t t-esc="tr('VAT reg.')"/> <t t-esc="co['vat_no']"/></t></div>
                            </div>
                            <div style="text-align:right; width:42%">
                                <h1 t-esc="title"/>
                                <div style="font-size:14px; font-weight:700" t-esc="d['number']"/>
                                <div><t t-esc="d['date']"/><t t-if="d['date_ec']"> · <t t-esc="d['date_ec']"/></t></div>
                            </div>
                        </div>
                        <div t-if="tpl in ('modern', 'bold') and st.get('show_company_address')" class="muted" style="margin:-8px 0 12px 2px">
                            <t t-esc="co['address']"/><t t-if="co['phone']"> · <t t-esc="co['phone']"/></t><t t-if="co['email']"> · <t t-esc="co['email']"/></t>
                        </div>
                        <div t-if="d['status_mark']" style="margin-bottom:8px"><span class="mark" t-esc="d['status_mark']"/></div>
                    </t>
                    <div t-if="d.get('not_tax_invoice')" t-attf-style="border: 1.5px solid {{ d['colors'][0] }}; color: {{ d['colors'][0] }}; text-align:center; font-weight:700; letter-spacing:.06em; padding:5px 8px; margin:0 0 10px; font-size:{{ '10px' if receipt else '12px' }}; font-family: 'Noto Sans Ethiopic', {{ font }};">
                        NOT A TAX INVOICE · ይህ የግብር ደረሰኝ አይደለም
                    </div>
                    <div t-if="st.get('header_note')" class="muted" style="margin-bottom:8px; white-space:pre-line" t-esc="st['header_note']"/>

                    <!-- parties and details -->
                    <div class="parties" t-if="d.get('party') or d.get('meta')">
                        <div t-if="d.get('party')">
                            <div class="lbl" t-esc="d['party']['label']"/>
                            <div class="pname" t-esc="d['party']['name']"/>
                            <div t-if="d['party']['tin'] and st.get('show_tin')"><t t-esc="tr('TIN')"/> <t t-esc="d['party']['tin']"/></div>
                            <div t-if="d['party']['address']" class="muted" t-esc="d['party']['address']"/>
                            <div t-if="d['party']['phone']" class="muted" t-esc="d['party']['phone']"/>
                        </div>
                        <div t-attf-style="{{ '' if receipt else 'text-align:right' }}">
                            <table class="meta" t-attf-style="{{ '' if receipt else 'margin-left:auto' }}">
                                <tr t-foreach="d.get('meta') or []" t-as="m"><td class="muted" t-esc="m[0]"/><td><b t-esc="m[1]"/></td></tr>
                            </table>
                        </div>
                    </div>

                    <!-- lines -->
                    <t t-set="cols" t-value="[c for c in d.get('columns', []) if not c.get('opt') or st.get(c['opt'])]"/>
                    <t t-if="receipt">
                        <t t-set="cols" t-value="[c for c in cols if c['key'] in ('desc', 'qty', 'amount', 'acc', 'debit', 'credit', 'doc', 'to')]"/>
                    </t>
                    <table class="lines">
                        <thead><tr><th t-foreach="cols" t-as="c" t-att-class="'r' if c['align'] == 'right' else ''"><t t-esc="c['label']"/><div t-if="c.get('label_am')" style="font-weight:normal; text-transform:none; letter-spacing:0" t-esc="c['label_am']"/></th></tr></thead>
                        <tbody>
                            <tr t-foreach="d.get('lines', [])" t-as="l">
                                <td t-foreach="cols" t-as="c" t-att-class="'r' if c['align'] == 'right' else ''">
                                    <t t-esc="l.get(c['key'], '')"/>
                                    <div t-if="c['key'] == 'desc' and st.get('show_codes') and l.get('code') and l['code'] not in (l.get('desc') or '')" class="code" t-esc="l['code']"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- totals, words, fiscal -->
                    <div class="bottom">
                        <div t-attf-style="{{ 'display:block' if receipt else 'width:55%; padding-right:18px' }}">
                            <div t-if="d.get('words_en')"><span class="lbl">Amount in words</span><br/><t t-esc="d['words_en']"/></div>
                            <div t-if="d.get('words_am')" style="margin-top:4px"><span class="lbl">የገንዘቡ መጠን በፊደል</span><br/><t t-esc="d['words_am']"/></div>
                            <div t-if="st.get('show_notes') and d.get('notes')" style="margin-top:8px; white-space:pre-line" class="muted" t-esc="d['notes']"/>
                            <table t-if="d.get('fiscal')" class="meta" style="margin-top:8px">
                                <tr t-foreach="d['fiscal']" t-as="f"><td class="muted" style="padding-left:0" t-esc="f[0]"/><td><b t-esc="f[1]"/></td></tr>
                            </table>
                        </div>
                        <div t-attf-style="{{ 'display:block; margin-top:6px' if receipt else 'width:45%' }}">
                            <table class="totals">
                                <tr t-foreach="d.get('totals', [])" t-as="t" t-att-class="'strong' if t[2] else ''"><td t-esc="t[0]"/><td class="r" t-esc="t[1]"/></tr>
                            </table>
                            <div t-if="st.get('show_qr') and d.get('qr')" t-attf-style="{{ 'text-align:center' if receipt else 'text-align:right' }}; margin-top:8px">
                                <img t-att-src="image_data_uri(d['qr'])" style="width:96px; height:96px"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="st.get('show_bank') and st.get('bank_details')" style="margin-top:12px"><span class="lbl" t-esc="tr('Pay to')"/><div style="white-space:pre-line" t-esc="st['bank_details']"/></div>
                    <div t-if="st.get('show_terms') and st.get('terms')" style="margin-top:10px"><span class="lbl" t-esc="tr('Terms')"/><div class="muted" style="white-space:pre-line" t-esc="st['terms']"/></div>

                    <div class="sig" t-if="d.get('signatures') or st.get('show_stamp')">
                        <div t-foreach="d.get('signatures') or []" t-as="s"><div class="line" t-esc="s"/><div class="muted" t-esc="tr('Name, signature, date')"/></div>
                        <div t-if="st.get('show_stamp')" style="width:120px"><div class="stamp" t-esc="tr('Stamp')"/></div>
                    </div>
                    <div class="foot">
                        <t t-if="st.get('footer')"><span style="white-space:pre-line" t-esc="st['footer']"/></t>
                        <t t-else=""><t t-esc="co['name']"/><t t-if="co['website']"> · <t t-esc="co['website']"/></t></t>
                    </div>
                </div>
                <p style="page-break-after: always;"/>
            </t>
        </t>
    </template>
</odoo>
